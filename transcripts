            try:
                with open(wj) as fh: wcfg = json.load(fh)
                folder = re.sub(r"^file://", "", str(wcfg.get("folder") or wcfg.get("workspace") or ""))
            except Exception: pass
            try: con, td = db_ro(wdb)
            except Exception as e:
                errors.append(f"{wdb}: {e}"); continue
            try:
                try:
                    for (v,) in con.execute("select value from ItemTable where key='composer.composerData'"):
                        dd = jload(v)
                        if not isinstance(dd, dict): continue
                        for comp in dd.get("allComposers") or []:
                            cid = comp.get("composerId")
                            if not cid: continue
                            e = wmeta.setdefault(cid, {})
                            for k in ("name", "lastUpdatedAt", "createdAt"):
                                if comp.get(k): e[k] = comp[k]
                            if folder: wfold[cid] = folder
                except Exception: pass
                try:
                    for (v,) in con.execute(
                            "select value from ItemTable where key='workbench.panel.aichat.view.aichat.chatdata'"):
                        dd = jload(v)
                        if not isinstance(dd, dict): continue
                        for tab in dd.get("tabs") or []:
                            bubbles = tab.get("bubbles") or []
                            first = next((bub_text(b) for b in bubbles
                                          if b.get("type") == "user" and bub_text(b)), "")
                            last = ""; role = ""
                            for b in reversed(bubbles):
                                t = bub_text(b)
                                if t:
                                    last, role = t, ("user" if b.get("type") == "user" else "cursor")
                                    break
                            if not (first or last or tab.get("chatTitle")): continue
                            ts = (tab.get("lastSendTime") or 0) / 1000.0 or os.path.getmtime(wdb)
                            tid = tab.get("tabId") or ""
                            rows.append(mkrow("cursor", "app", tid or "tab",
                                              tab.get("chatTitle") or first or "(chat)",
                                              role, last, ts, wdb, f"cl|{wdb}|{tid}",
                                              os.path.basename(folder.rstrip("/")), folder))
                except Exception: pass
                # some Cursor versions keep composer transcripts per-workspace too
                try:
                    if con.execute("select name from sqlite_master where type='table' "
                                   "and name='cursorDiskKV'").fetchone():
                        scan_kv_composers(con, wdb, wmeta, wfold, rows, include_sub, errors)
                except Exception: pass
            finally:
                con.close()
                if td: shutil.rmtree(td, ignore_errors=True)
        gdb = os.path.join(userdir, "globalStorage", "state.vscdb")
        if not os.path.exists(gdb):
            continue
        try: con, td = db_ro(gdb)
        except Exception as e:
            errors.append(f"{gdb}: {e}"); continue
        try:
            scan_kv_composers(con, gdb, wmeta, wfold, rows, include_sub, errors,
                              extra_ids=set(wmeta))
        finally:
            con.close()
            if td: shutil.rmtree(td, ignore_errors=True)

# ------------------------------------------------------------- index / emit
TAGC = {"claude·code": YL, "claude·cwrk": YL, "cursor·app": CY, "cursor·cli": CY, "cursor·sub": DIM}

DEDUPED = 0

def collect(agent, include_sub):
    global DEDUPED
    rows, errors = [], []
    if agent in ("all", "claude", ""): scan_claude(rows, errors)
    if agent in ("all", "cursor", ""):
        scan_cursor_app(rows, errors, include_sub)
        scan_cursor_cli(rows, errors, include_sub)
        if include_sub: scan_cursor_agents(rows, errors)
    cache_save()
    best = {}          # same session id may exist in several accounts/stores (sync) — keep newest
    for r in rows:
        k = (r["a"], r["s"], r["i"])
        o = best.get(k)
        if o is None or r["t"] > o["t"]: best[k] = r
    DEDUPED = len(rows) - len(best)
    rows = sorted(best.values(), key=lambda r: -r["t"])
    return rows, errors

def emit_index(agent, query, include_sub, content=False, dirspec=""):
    sel, _ = _filter_rows(agent, query, include_sub, "all", content, dirspec)
    out = []
    for r in sel:
        z = r.get("z") or ""
        tag = f'{r["a"]}·{r["s"]}'
        col = TAGC.get(tag, "")
        rolec = CY if r["r"] == "user" else MG
        who = "you" if r["r"] == "user" else (r["r"] or "-")
        lm = clean(r["l"], 110)
        zt = tail_disp(r["l"], z, 110, 110)
        vis = dwidth(lm) + (3 + dwidth(zt) if zt else 0)
        if zt: lm += f' {DIM}⋯{R} {zt}'
        lm += " " * max(0, 110 - vis)      # fixed width: keeps field 3 past the right edge
        disp = (f'{DIM}{rpad_w(rel(r["t"]), 4)}{R} {col}{pad_w(tag, 11)}{R} '
                f'{DIM}{pad_w(r["i"][:8], 8)}{R} '
                f'{BOLD}{pad_w(clean(r["n"]), 44)}{R} {GR}{pad_w(clean(r["j"]), 16)}{R} '
                f'{rolec}{rpad_w(who, 6)}:{R} {lm}')
        # Field 3 is the full cached text. fzf matches fields 2.. but renders from the left with
        # --no-hscroll, and the padding above puts field 3 ~205 columns in — so typing in the TUI
        # searches everything the cache knows while only the columns stay on screen.
        # (--nth can't do this: fzf applies --nth AFTER --with-nth, so a hidden field is unmatchable.)
        out.append(esc(r["f"]) + "\t" + esc(disp) + "\t" + esc(row_hay(r)))
    sys.stdout.write("\n".join(out) + ("\n" if out else ""))

