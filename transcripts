                            first = next((bub_text(b) for b in bubbles
                                          if b.get("type") == "user" and bub_text(b)), "")
                            last = ""; role = ""
                            for b in reversed(bubbles):
                                t = bub_text(b)
                                if t:
                                    last, role = t, ("user" if b.get("type") == "user" else "cursor")
                                    break
                            if not (first or last or tab.get("chatTitle")): continue
                            ts = (tab.get("lastSendTime") or 0) / 1000.0 or os.path.getmtime(wdb)
                            tid = tab.get("tabId") or ""
