def since_seconds(spec):
    """'10d'/'5h'/'30m' -> seconds; ''/'all' -> None; invalid -> exit 1."""
    s = (spec or "").strip().lower()
    if s in ("", "all", "full"): return None
    m = re.fullmatch(r"(\d+)([dhm])", s)
    if not m:
        sys.stderr.write(f"transcripts: invalid --since '{spec}' — use Nd, Nh or Nm (e.g. 10d, 5h, 30m)\n")
        sys.exit(1)
    return int(m.group(1)) * {"d": 86400, "h": 3600, "m": 60}[m.group(2)]

HOME = os.environ.get("TRANSCRIPTS_HOME") or os.path.expanduser("~")
