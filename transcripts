        if td: shutil.rmtree(td, ignore_errors=True)

def cj_messages(f, limit):
    msgs = []
    try:
        with open(f, "rb") as fh: lines = fh.read().split(b"\n")
    except OSError:
        return msgs
    for b in lines:
        d = jload(b)
        if not d or d.get("role") not in ("user", "assistant"): continue
        t = cursor_msg_text({"role": d.get("role"), "content": (d.get("message") or {}).get("content")})
        if t: msgs.append(("user" if d["role"] == "user" else "cursor", t, ""))
    return msgs[-limit:]

def get_messages(ref, limit):
    typ, path, rid = ref.split("|", 2)
    title = ""
    if typ == "cc": msgs = cc_messages(path, limit)
    elif typ == "cs": msgs = store_messages(path, limit)
    elif typ == "ca": msgs, title = composer_messages(path, rid, limit)
    elif typ == "cl": msgs, title = tab_messages(path, rid, limit)
    elif typ == "cj": msgs = cj_messages(path, limit)
    else: msgs = []
    return typ, path, rid, msgs, title

def cc_own_title(path):
    try:
        head, tail = head_tail(path, 300, 262144)
    except OSError:
        return ""
    ai = cu = summ = ""
    for b in list(head) + list(tail):
        d = jload(b)
        if not d: continue
        t = d.get("type")
        if t == "custom-title" and d.get("customTitle"): cu = d["customTitle"]
        elif t == "ai-title" and d.get("aiTitle"): ai = d["aiTitle"]
        elif t == "summary" and d.get("summary") and not summ: summ = d["summary"]
    return cu or ai or summ

def do_details(ref):
    try:
        typ, path, rid, msgs, title = get_messages(ref, 14)
    except Exception as e:
        print(f"could not parse ref: {e}"); return
    if typ == "cc" and not title: title = cc_own_title(path)
    names = {"cc": "Claude session (jsonl)", "cs": "Cursor CLI chat", "ca": "Cursor app chat",
             "cl": "Cursor app chat (legacy)", "cj": "Cursor subagent run"}
    try: mt = fmt_ts(os.path.getmtime(path))
    except OSError: mt = "?"
    print(f"{BOLD}{GR}● {title or names.get(typ, typ)}{R}")
    sub = (f"{names.get(typ, typ)} · " if title else "") + f"updated {mt}"
    print(f"{DIM}   {sub}{R}")
    print(f"{DIM}   id     {R}{rid}")
    print(f"{DIM}   file   {R}{path}")
    print(f"{DIM}{'─' * 34} latest message first ▼{R}")
    if not msgs:
        print(f"{DIM}(no displayable messages){R}")
    for role, t, ts in reversed(msgs):
        col = CY if role == "user" else MG
        who = "you" if role == "user" else role
        t = re.sub(r"\n{3,}", "\n\n", t.strip())
        if len(t) > 700: t = t[:700] + " …"
        print(f"{col}{BOLD}▌ {who}{R}{DIM}{(' · ' + ts) if ts else ''}{R}")
        print(t)
        print()

def do_export(ref):
    typ, path, rid, msgs, title = get_messages(ref, 400)
    dl = os.path.join(HOME, "Downloads")
    if not os.path.isdir(dl): dl = tempfile.gettempdir()
    if not title and msgs:
        title = next((t for r_, t, _ in msgs if r_ == "user"), msgs[0][1])[:60]
    slug = re.sub(r"[^A-Za-z0-9]+", "-", (title or "transcript"))[:40].strip("-") or "transcript"
    out = os.path.join(dl, f"transcript-{typ}-{rid[:8]}-{slug}.md")
    with open(out, "w") as f:
        f.write(f"# {title or 'Transcript'}\n\n- source: `{path}`\n- id: `{rid}`\n\n---\n\n")
        for role, t, ts in msgs:
            f.write(f"### {role}{(' — ' + ts) if ts else ''}\n\n{t.strip()}\n\n---\n\n")
    print(out)

def do_doctor(include_sub):
    print(f"transcripts doctor (v-py) HOME={HOME}")
    t0 = time.time()
    checks = [
        ("claude projects (~/.claude/projects)", os.path.join(HOME, ".claude", "projects")),
        ("claude cowork (app sessions dir)", os.path.join(HOME, "Library", "Application Support",
                                                          "Claude", "local-agent-mode-sessions")),
        ("cursor cli (~/.cursor/chats)", os.path.join(HOME, ".cursor", "chats")),
        ("cursor subagents (~/.cursor/projects)", os.path.join(HOME, ".cursor", "projects")),
    ] + [(f"cursor app ({d})", d) for d in
         (os.path.join(HOME, "Library", "Application Support", "Cursor", "User"),
          os.path.join(HOME, ".config", "Cursor", "User"))]
    for label, p in checks:
        print(f"  {'✔' if os.path.isdir(p) else '✘'} {label}")
    rows, errors = collect("all", True)
    from collections import Counter
    c = Counter(f'{r["a"]}·{r["s"]}' for r in rows)
    print(f"  indexed {len(rows)} transcripts in {time.time()-t0:.1f}s: " +
          ", ".join(f"{k}={v}" for k, v in sorted(c.items())))
    if any(TITLE_STATS.values()):
        print("  claude titles: " + ", ".join(f"{k}={v}" for k, v in TITLE_STATS.items() if v))
    homes = _user_homes()
    print(f"  account homes scanned: {', '.join(homes)}")
    if DEDUPED: print(f"  deduped {DEDUPED} synced duplicates (same id, kept newest)")
    if UNTITLED_SAMPLES:
        print("  still-untitled examples (paste these to debug):")
        for p in UNTITLED_SAMPLES: print(f"    ? {p}")
    if rows:
        r = rows[0]
        print(f"  newest: [{r['a']}·{r['s']}] {r['n'][:60]!r} → {r['p']}")
    if errors:
        print(f"  {len(errors)} parse errors (first 10):")
        for e in errors[:10]: print(f"    ! {e}")
    print(f"  cache: {CACHE_FILE}")

def _filter_rows(agent, query, include_sub, since_spec, content=False):
    """The single filter. Metadata match is free (cached); --content additionally opens the
    newest SCAN_CAP non-matching transcripts and searches the conversation itself."""
    secs = since_seconds(since_spec)
    cutoff = (time.time() - secs) if secs is not None else None
    rows, _ = collect(agent, include_sub)
    terms = qterms(query)
    sel = []
    scanned = skipped = 0
    for r in rows:
        if cutoff is not None and r["t"] < cutoff:
            break        # rows are sorted newest-first
        if not terms or qmatch(terms, row_hay(r)):
            sel.append(r)
            continue
        if not content:
            continue
        if scanned >= SCAN_CAP:
            skipped += 1     # never silently truncate — reported below
            continue
        scanned += 1
        if qmatch(terms, body_text(r)):
            sel.append(r)
    if skipped:
        sys.stderr.write(
            f"transcripts: --content read the {scanned} newest transcripts; {skipped} older ones "
            f"were NOT searched. Narrow with --since/--agent, or raise --scan (default {SCAN_CAP}).\n")
    return sel, secs

def _pad(s, w):
    s = clean(s, w)
    return s + " " * (w - len(s))

def _pad_end(s, w):
    s = clean_end(s, w)
    return s + " " * (w - len(s))

def emit_table(agent, query, include_sub, since_spec, content=False):
    sel, secs = _filter_rows(agent, query, include_sub, since_spec, content)
    try: width = os.get_terminal_size(sys.__stdout__.fileno()).columns
    except Exception:
        try: width = int(os.environ.get("COLUMNS") or 120)
        except ValueError: width = 120
    width = max(width, 110)
    IDW, SRW, UPW = 8, 11, 12
    flex = width - 19 - (IDW + SRW + UPW)
    TW = max(20, int(flex * 0.30))
    HW = max(18, int(flex * 0.36))
    ZW = max(18, flex - TW - HW)
    widths = [IDW, SRW, UPW, TW, HW, ZW]
    W = sum(widths) + 19
    w_desc = "all time" if secs is None else f"last {since_spec.strip().lower()}"
    def hline(lft, mid, rgt):
        return DIM + lft + mid.join("─" * (w + 2) for w in widths) + rgt + R
    sep = DIM + "│" + R
    out = [f"{DIM}transcripts · agent={agent} · {w_desc} · {len(sel)} shown"
           f"{(' · filter: ' + query) if query else ''} · full paths: --tsv or pipe{R}",
           hline("┌", "┬", "┐"),
           sep + sep.join(f" {BOLD}{_pad(h, w)}{R} " for h, w in
                          zip(["ID", "SOURCE", "UPDATED", "TITLE",
                               "LAST MESSAGE HEAD", "LAST MESSAGE TAIL"], widths)) + sep,
           hline("├", "┼", "┤")]
    home = os.path.expanduser("~")
    for r in sel:
        tag = f'{r["a"]}·{r["s"]}'
        pfx = ("you" if r["r"] == "user" else r["r"]) + ": " if r["r"] else ""
        cells = [DIM + _pad(r["i"][:8], IDW) + R,
                 (TAGC.get(tag, "")) + _pad(tag, SRW) + R,
                 _pad(time.strftime("%d %b %H:%M", time.localtime(r["t"])), UPW),
                 BOLD + _pad(r["n"], TW) + R,
                 _pad(pfx + r["l"], HW),
                 _pad_end(tail_disp(r["l"], r.get("z") or "", HW - len(pfx), ZW), ZW)]
        out.append(sep + sep.join(f" {c} " for c in cells) + sep)
        p = r["p"]
        if p.startswith(home): p = "~" + p[len(home):]
        pw = W - 6
        if len(p) > pw: p = "…" + p[-(pw - 1):]
        out.append(DIM + "│ ⤷ " + p + " " * (pw - len(p)) + " │" + R)
    out.append(hline("└", "┴", "┘"))
    if not sel:
        out.append("nothing in this window — try --since=7d or --full-list")
    print("\n".join(out))

def emit_plain(agent, query, include_sub, as_json, since_spec, content=False):
    sel, _secs = _filter_rows(agent, query, include_sub, since_spec, content)
    for r in sel:
        if as_json:
            print(json.dumps({"id": r["i"], "source": f'{r["a"]}·{r["s"]}',
                              "updated": fmt_ts(r["t"]), "updated_ts": int(r["t"]),
                              "title": r["n"], "project": r["j"], "last_role": r["r"],
                              "last_message_head": clean(r["l"], 200),
                              "last_message_tail": tail_disp(r["l"], r.get("z") or "", 200, 200),
                              "path": r["p"], "ref": r["f"]}, ensure_ascii=False))
        else:
            print("\t".join(esc(x) for x in (
                r["i"], f'{r["a"]}·{r["s"]}', fmt_ts(r["t"]), clean(r["n"], 80),
                clean(r["l"], 160), tail_disp(r["l"], r.get("z") or "", 160, 160), r["p"])))

if CMD == "index":
    emit_index(ARG1 or "all", ARG2, ARG3 == "1", ARG4 == "1")
elif CMD == "list":
    emit_plain(ARG1 or "all", ARG2, ARG3 == "1", False, ARG4, ARG5 == "1")
elif CMD == "json":
    emit_plain(ARG1 or "all", ARG2, ARG3 == "1", True, ARG4, ARG5 == "1")
elif CMD == "table":
    emit_table(ARG1 or "all", ARG2, ARG3 == "1", ARG4, ARG5 == "1")
elif CMD == "legend":
    print(f'{DIM}{"AGE":>4} {"SOURCE":<11} {"ID":<8} {"TITLE":<44} {"PROJECT":<16} {"FROM":>6}  LAST MESSAGE HEAD ⋯ TAIL{R}')
elif CMD == "details":
    do_details(ARG1)
elif CMD == "export":
    do_export(ARG1)
elif CMD == "doctor":
    do_doctor(True)
elif CMD == "path":
    print(ARG1.split("|", 2)[1])
else:
    sys.exit(f"unknown internal command: {CMD}")
PYCODE
}

# ---------------------------------------------------------------- helpers
ref_path() { printf '%s' "$1" | cut -d'|' -f2; }

copy_ref_path() {
  local p; p="$(ref_path "$1")"
  printf '%s' "$p" | _clip 2>/dev/null
}

state_agent() { cat "$1" 2>/dev/null || echo all; }

cycle_state() { # STATE -> writes next agent, prints nothing
  local cur next
  cur="$(state_agent "$1")"
  case "$cur" in
    all) next=claude ;;
    claude) next=cursor ;;
    *) next=all ;;
  esac
  printf '%s' "$next" > "$1"
}

do_install() {
  local dest="$HOME/.local/bin/transcripts"
  mkdir -p "$HOME/.local/bin"
  chmod +x "$SELF"
  if [ "$SELF" != "$dest" ]; then ln -sf "$SELF" "$dest"; fi
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *)
      for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        [ -f "$rc" ] || [ "$rc" = "$HOME/.zshrc" ] || continue
        if ! grep -qs 'transcripts-path' "$rc" && ! grep -qs '\.local/bin' "$rc"; then
          printf '\nexport PATH="$HOME/.local/bin:$PATH" # added by transcripts-path\n' >> "$rc"
          echo "added ~/.local/bin to PATH in $rc"
        fi
      done
      ;;
  esac
  echo "installed: $dest -> $SELF"
  echo "open a new shell (or: export PATH=\"\$HOME/.local/bin:\$PATH\") and run: transcripts"
}

# print the header comment block, however long it grows
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; }

# ---------------------------------------------------------------- arg parsing
AGENT="" QUERY="" SUB=0 CMD="" MODE="" SINCE="" CONTENT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --agent=*) AGENT="${1#*=}" ;;
    --agent|-a) shift; AGENT="${1:-}" ;;
    --query=*) QUERY="${1#*=}" ;;
    --query|-q) shift; QUERY="${1:-}" ;;
    --content|-c) CONTENT=1 ;;
    --scan=*) export TRANSCRIPTS_SCAN="${1#*=}" ;;
    --scan) shift; export TRANSCRIPTS_SCAN="${1:-}" ;;
    --list|-l|--print) MODE=list ;;
    --json) MODE=json ;;
    --table) MODE=table ;;
    --tsv) MODE=tsv ;;
    --since=*) SINCE="${1#*=}" ;;
    --since|-s) shift; SINCE="${1:-}" ;;
    --full-list|--all|--full) SINCE=all ;;
    --subagents) SUB=1 ;;
    --install) do_install; exit $? ;;
    --doctor) run_py doctor; exit $? ;;
    --details) shift; run_py details "${1:-}"; exit $? ;;
    --export) shift; run_py export "${1:-}"; exit $? ;;
    --version) echo "transcripts $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    __index) run_py index "${2:-all}" "${3:-}" "${4:-0}"; exit $? ;;
    __details) run_py details "${2:-}"; exit $? ;;
    __export) run_py export "${2:-}"; exit $? ;;
    __copy) copy_ref_path "${2:-}"; exit 0 ;;
    __reload) # __reload STATE SUB QUERY [next|content]
      st="${2:-}"; sb="${3:-0}"; q="${4:-}"; md="${5:-}"
      [ "$md" = "next" ] && cycle_state "$st"
      run_py index "$(state_agent "$st")" "$q" "$sb" \
        "$([ "$md" = "content" ] && echo 1 || echo 0)"; exit $? ;;
    *) echo "transcripts: unknown option $1 (see --help)"; exit 1 ;;
  esac
  shift
done

case "$AGENT" in ""|all|claude|cursor) ;; *) echo "transcripts: --agent must be claude|cursor|all"; exit 1 ;; esac

# ---------------------------------------------------------------- non-interactive list
[ -n "$SINCE" ] && [ -z "$MODE" ] && MODE=list   # --since/--full-list imply --list
if [ -n "$MODE" ]; then
  FMT="$MODE"
  if [ "$MODE" = list ]; then                     # auto: pretty table on tty, TSV when piped
    if [ -t 1 ]; then FMT=table; else FMT=list; fi
  elif [ "$MODE" = tsv ]; then FMT=list
  fi
  # searching a 24h window is a surprise, not a default: a query means "look everywhere"
  if [ -z "$SINCE" ]; then
    if [ -n "$QUERY" ]; then SINCE=all; else SINCE=24h; fi
  fi
  run_py "$FMT" "${AGENT:-all}" "$QUERY" "$SUB" "$SINCE" "$CONTENT"
  exit $?
fi

# ---------------------------------------------------------------- agent picker
if [ -z "$AGENT" ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    if command -v fzf >/dev/null 2>&1 && [ -z "${TRANSCRIPTS_NO_FZF:-}" ]; then
      pick="$(printf 'all      show everything\nclaude   Claude Code + Cowork sessions\ncursor   Cursor app + cursor-agent CLI chats\n' | \
        fzf --prompt='  agent › ' --height=8 --reverse --info=hidden \
            --header='Whose transcripts do you want to browse? (↑↓ + enter, or type)' || true)"
      [ -z "$pick" ] && exit 130
      AGENT="${pick%% *}"
    else
      printf 'Browse which transcripts?  [1] all (default)  [2] claude  [3] cursor : '
      read -r n
      case "$n" in 2) AGENT=claude ;; 3) AGENT=cursor ;; *) AGENT=all ;; esac
    fi
  else
    AGENT=all
  fi
fi

STATE="$(mktemp "${TMPDIR:-/tmp}/transcripts.XXXXXX")"
printf '%s' "$AGENT" > "$STATE"
trap 'rm -f "$STATE"' EXIT

# ---------------------------------------------------------------- fzf TUI
if command -v fzf >/dev/null 2>&1 && [ -z "${TRANSCRIPTS_NO_FZF:-}" ]; then
  SELQ="'$SELF'"
  LEGEND="  $(run_py legend)"
  HDR="$LEGEND
 ⏎ pick (copies path) · ⇥ show/hide transcript · ^F search inside transcripts · ^A switch agent
 ^E export .md · ^Y copy path · ^R refresh (back to fast filter) · esc quit"
  sel="$(run_py index "$AGENT" "$QUERY" "$SUB" "$CONTENT" | fzf \
    --ansi --delimiter='\t' --with-nth=2.. --no-hscroll --tiebreak=index \
    --exact --info=inline \
    --prompt="  $AGENT ${QUERY:+[$QUERY] }› type to filter: " \
    --header="$HDR" \
    --preview="$SELQ __details {1}" \
    --preview-window='down:60%:wrap' \
    --bind='tab:toggle-preview' \
    --bind="ctrl-f:reload($SELQ __reload '$STATE' $SUB {q} content)+change-prompt(  $AGENT › matched inside transcripts, refine: )+clear-query" \
    --bind="ctrl-a:reload($SELQ __reload '$STATE' $SUB '' next)+change-prompt(  $AGENT › type to filter: )+clear-query" \
    --bind="ctrl-r:reload($SELQ __reload '$STATE' $SUB '')+change-prompt(  $AGENT › type to filter: )" \
    --bind="ctrl-y:execute-silent($SELQ __copy {1})" \
    --bind="ctrl-e:execute-silent($SELQ __export {1})" \
  )"
  rc=$?
  if [ $rc -eq 0 ] && [ -n "$sel" ]; then
    ref="${sel%%$'\t'*}"
    p="$(ref_path "$ref")"
    if [ -t 1 ]; then
      if copy_ref_path "$ref"; then
        printf '\033[32m✔ transcript path (copied to clipboard):\033[0m\n'
      else
        printf '\033[32m✔ transcript path:\033[0m\n'
      fi
      printf '  %s\n' "$p"
      case "$ref" in
        ca\|*|cl\|*)
          printf '\033[2m  (this chat lives inside that Cursor sqlite db — id %s;\n   use the export below for a plain file)\033[0m\n' \
            "$(printf '%s' "$ref" | cut -d'|' -f3)" ;;
      esac
      printf '\033[2mview again:\033[0m transcripts --details '\''%s'\''\n' "$ref"
      printf '\033[2mexport .md:\033[0m transcripts --export  '\''%s'\''\n' "$ref"
    else
      printf '%s\n' "$p"
    fi
    exit 0
  elif [ $rc -eq 2 ]; then
    echo "transcripts: fzf failed, dropping to basic picker" >&2
  else
    exit 130   # user cancelled / no match
  fi
fi

# ---------------------------------------------------------------- fallback TUI (no fzf)
echo "tip: 'brew install fzf' unlocks the nicer TUI (live fuzzy filter + preview pane)." >&2
OFF=0; PAGE=25
while :; do
  LIST="$(run_py index "$(state_agent "$STATE")" "$QUERY" "$SUB" "$CONTENT")"
  TOTAL=$(printf '%s' "$LIST" | grep -c . || true)
  echo
  printf '\033[1m── transcripts · agent: %s%s · %s found ──\033[0m\n' \
    "$(state_agent "$STATE")" "$([ -n "$QUERY" ] && printf ' · filter: "%s"' "$QUERY")" "$TOTAL"
  printf '  #  %s\n' "$(run_py legend)"
  if [ "$TOTAL" -eq 0 ]; then
    echo "  (nothing matches — try 'a' to switch agent or '/' to change the filter)"
  else
    printf '%s\n' "$LIST" | sed -n "$((OFF + 1)),$((OFF + PAGE))p" | awk -F'\t' -v o="$OFF" '{printf "%3d  %s\n", NR + o, $2}'
    printf '\033[2m  showing %s-%s of %s\033[0m\n' \
      "$((OFF + 1))" "$(( (OFF + PAGE) < TOTAL ? OFF + PAGE : TOTAL ))" "$TOTAL"
  fi
  echo
  echo "  type a #      open that transcript (latest messages first)"
  echo "  /words        filter list (all words must match) · / alone clears"
  echo "  a=switch agent  n=next page  p=prev page  s=toggle subagents  c=search inside  q=quit"
  printf '› '
  read -r ans || exit 0
  case "$ans" in
    q) exit 0 ;;
    a) cycle_state "$STATE"; OFF=0 ;;
    s) SUB=$((1 - SUB)); OFF=0 ;;
    c) CONTENT=$((1 - CONTENT)); OFF=0 ;;
    n) [ $((OFF + PAGE)) -lt "$TOTAL" ] && OFF=$((OFF + PAGE)) ;;
    p) OFF=$((OFF - PAGE)); [ "$OFF" -lt 0 ] && OFF=0 ;;
    /*) QUERY="${ans#/}"; OFF=0 ;;
    ''|*[!0-9]*) ;;
    *)
      ref="$(printf '%s\n' "$LIST" | sed -n "${ans}p" | cut -f1)"
      [ -z "$ref" ] && continue
      run_py details "$ref" | ${PAGER:-less -R}
      p="$(ref_path "$ref")"
      printf 'c=copy+print path   e=export .md   enter=back to list › '
      read -r act
      case "$act" in
        c) printf '%s\n' "$p"; copy_ref_path "$ref" && echo "✔ copied to clipboard" ;;
        e) echo "exported: $(run_py export "$ref")" ;;
      esac
      ;;
  esac
done
