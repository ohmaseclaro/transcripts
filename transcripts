        return json.loads(bytes.fromhex(v))
    except Exception:
        return {}

def parse_store(db, st):
    d = os.path.dirname(db)
    meta = {}
    mj = os.path.join(d, "meta.json")
    if os.path.exists(mj):
        try:
            with open(mj) as fh: meta = json.load(fh)
        except Exception: pass
    if meta.get("hasConversation") is False: return None
    con, td = db_ro(db)
    try:
        m0 = store_meta0(con)
        sub = bool(m0.get("subagentInfo"))
        name = meta.get("title")
        if not name and m0.get("name") and m0["name"] != "New Agent":
            name = m0["name"]
        first = last = None; role = ""
        try:
            for (data,) in con.execute("select data from blobs order by rowid limit 40"):
                j = jload(data)
                if isinstance(j, dict) and j.get("role") == "user":
                    t = cursor_msg_text(j)
                    if t: first = t; break
            for (data,) in con.execute("select data from blobs order by rowid desc limit 80"):
                j = jload(data)
                if isinstance(j, dict) and j.get("role") in ("user", "assistant"):
                    t = cursor_msg_text(j)
                    if t:
                        last, role = t, ("user" if j["role"] == "user" else "cursor")
                        break
        except Exception: pass
        if not (name or first or last): return None
        sid = os.path.basename(d)
        ts = (meta.get("updatedAtMs") or 0) / 1000.0 or st.st_mtime
        proj = os.path.basename((meta.get("cwd") or "").rstrip("/"))
        return mkrow("cursor", "sub" if sub else "cli", sid, name or first or "(untitled)",
                     role, last or "", ts, db, f"cs|{db}|{sid}", proj)
    finally:
        con.close()
        if td: shutil.rmtree(td, ignore_errors=True)

