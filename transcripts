def cursor_msg_text(j):
    c = j.get("content")
    if isinstance(c, str): t = c
    elif isinstance(c, list):
        t = "\n".join(p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") == "text")
    else: t = ""
    t = t.strip()
    if not t or t == "[REDACTED]": return None
    m = re.search(r"<user_query>\s*(.*?)\s*</user_query>", t, re.S)
    if m:
        t = m.group(1).strip()
    elif t.startswith(("<user_info>", "<system", "<additional_data", "<project_layout", "<attached")):
        return None
    return t or None

def store_meta0(con):
    try:
        r = con.execute("select value from meta where key='0'").fetchone()
        if not r: return {}
        v = r[0]
