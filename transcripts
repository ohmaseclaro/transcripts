def rich_to_text(rt):
    try:
        d = json.loads(rt) if isinstance(rt, str) else rt
        out = []
        def walk(n):
            if isinstance(n, dict):
                if n.get("text"): out.append(n["text"])
                for v in n.values():
                    if isinstance(v, (dict, list)): walk(v)
            elif isinstance(n, list):
                for v in n: walk(v)
        walk(d)
        return " ".join(out)
    except Exception:
        return ""

def bub_text(b):
    if not isinstance(b, dict): return ""
    t = b.get("text") or ""
    if not t and b.get("richText"): t = rich_to_text(b["richText"])
    if not t and isinstance(b.get("delegate"), dict): t = b["delegate"].get("a") or ""
    return (t or "").strip()

def cursor_ts(v):
    """Cursor timestamps: ms since epoch (numbers > 1e12), seconds, or ISO strings → epoch s."""
    if isinstance(v, (int, float)) and v > 0:
        return v / 1000.0 if v > 1e12 else float(v)
    if isinstance(v, str) and v:
        try:
            from datetime import datetime
            return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
        except Exception: return 0
    return 0

def comp_ts(d, m):
    ts = 0
    for src_ in (d, m):
        for k in ("conversationCheckpointLastUpdatedAt", "lastUpdatedAt", "createdAt"):
            ts = max(ts, cursor_ts(src_.get(k)))
    return ts

def comp_proj(d, wfold, cid):
    """Project label: workspace folder if known, else common dir of originalFileStates."""
    p = wfold.get(cid) or ""
    if p: return os.path.basename(p.rstrip("/"))
    states = d.get("originalFileStates")
    paths = []
    if isinstance(states, dict): paths = [k for k in states.keys() if isinstance(k, str)]
    elif isinstance(states, list):
        for s_ in states:
            if isinstance(s_, str): paths.append(s_)
            elif isinstance(s_, dict):
                for k in ("uri", "path", "fsPath", "relativePath"):
                    if isinstance(s_.get(k), str): paths.append(s_[k]); break
    paths = [re.sub(r"^file://", "", p_) for p_ in paths]
    if not paths: return ""
    try: pref = os.path.commonpath(paths) if len(paths) > 1 else os.path.dirname(paths[0])
    except Exception: return ""
    segs = [s for s in pref.split("/") if s]
    return "/".join(segs[-2:]) if len(segs) >= 2 else (segs[-1] if segs else "")

def scan_kv_composers(con, dbpath, wmeta, wfold, rows, include_sub, errors, extra_ids=()):
    """Enumerate ALL composer transcripts inside a state.vscdb's cursorDiskKV.
    Indexed range scan, newest rowid first (composer updates re-insert with higher rowid)."""
    comp = {}
    try:
        for k, v in con.execute(
                "select key, value from cursorDiskKV where key >= 'composerData:' "
                "and key < 'composerData;' order by rowid desc limit 1000"):
            if isinstance(k, (bytes, bytearray)): k = k.decode("utf-8", "replace")
            cid = k.split(":", 1)[1]
            if cid in comp: continue
            dd = jload(v)
            if isinstance(dd, dict): comp[cid] = dd
    except Exception as e:
        errors.append(f"{dbpath} cursorDiskKV: {e}")
        comp = {}
    def bubble_get(cid, bid):
        try:
            r = con.execute("select value from cursorDiskKV where key=?",
                            (f"bubbleId:{cid}:{bid}",)).fetchone()
            return jload(r[0]) if r else None
        except Exception: return None
    for cid in set(comp) | set(extra_ids):
        d = comp.get(cid) or {}
        m = wmeta.get(cid) or {}
        sub = bool(d.get("subagentInfo"))
        if sub and not include_sub: continue
        name = m.get("name") or d.get("name") or ""
        if name == "New Agent": name = ""
        ts = comp_ts(d, m)
        first = last = ""; role = ""
        conv = d.get("conversation") or []
        if conv:
            for b in reversed(conv):
                t = bub_text(b)
                if t:
                    last, role = t, ("user" if b.get("type") == 1 else "cursor")
                    break
            for b in conv:
                if b.get("type") == 1 and bub_text(b):
                    first = bub_text(b); break
        else:
            hdrs = d.get("fullConversationHeadersOnly") or []
            tries = 0
            for h in reversed(hdrs):
                if tries >= 15: break
                tries += 1
                b = bubble_get(cid, h.get("bubbleId"))
                t = bub_text(b) if b else ""
                if t:
                    last = t
                    role = "user" if (h.get("type") == 1 or (b or {}).get("type") == 1) else "cursor"
                    break
        subtitle = d.get("subtitle") if isinstance(d.get("subtitle"), str) else ""
        if not (name or first or last or subtitle): continue
        rows.append(mkrow("cursor", "sub" if sub else "app", cid,
                          name or first or subtitle or "(untitled)", role, last, ts, dbpath,
                          f"ca|{dbpath}|{cid}", comp_proj(d, wfold, cid)))

