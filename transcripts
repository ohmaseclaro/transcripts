        proj = os.path.basename((meta.get("cwd") or "").rstrip("/"))
        return mkrow("cursor", "sub" if sub else "cli", sid, name or first or "(untitled)",
                     role, last or "", ts, db, f"cs|{db}|{sid}", proj, meta.get("cwd") or "")
