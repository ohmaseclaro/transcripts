BODY_MAX = 64 * 1024 * 1024

def cc_messages(f, limit, whole=False):
    """whole=True reads the entire session. The default tail-only read is fine for showing the
    last N messages, but searching it would silently miss everything before the last 2 MB."""
    msgs = []
    try:
        with open(f, "rb") as fh:
            if whole:
                lines = fh.read(BODY_MAX).split(b"\n")
            else:
                fh.seek(0, 2); size = fh.tell()
                fh.seek(max(0, size - 2_000_000))
                lines = fh.read().split(b"\n")
    except OSError:
        return msgs
    for b in lines:
        d = jload(b)
        if not d: continue
        if d.get("type") not in ("user", "assistant") or d.get("isSidechain"): continue
        t = cc_line_text(d)
        if t:
            msgs.append(("user" if d["type"] == "user" else "claude", t, d.get("timestamp") or ""))
    return msgs[-limit:]

def store_messages(db, limit):
    con, td = db_ro(db)
    try:
        msgs = []
        for (data,) in con.execute("select data from blobs order by rowid"):
            j = jload(data)
            if isinstance(j, dict) and j.get("role") in ("user", "assistant"):
                t = cursor_msg_text(j)
                if t: msgs.append(("user" if j["role"] == "user" else "cursor", t, ""))
        return msgs[-limit:]
    finally:
        con.close()
        if td: shutil.rmtree(td, ignore_errors=True)

def composer_messages(gdb, cid, limit):
    con, td = db_ro(gdb)
    try:
        r = con.execute("select value from cursorDiskKV where key=?", (f"composerData:{cid}",)).fetchone()
        d = jload(r[0]) if r else {}
        d = d if isinstance(d, dict) else {}
        msgs = []
        conv = d.get("conversation") or []
        if conv:
            for b in conv:
                t = bub_text(b)
                if t: msgs.append(("user" if b.get("type") == 1 else "cursor", t, ""))
        else:
            hdrs = (d.get("fullConversationHeadersOnly") or [])[-limit:]
            # One indexed range scan instead of a query per bubble: --content over a few
            # hundred composers turned this into six figures of round-trips.
            bubs = {}
            try:
                for k, v in con.execute(
                        "select key, value from cursorDiskKV where key >= ? and key < ?",
                        (f"bubbleId:{cid}:", f"bubbleId:{cid};")):
                    if isinstance(k, (bytes, bytearray)): k = k.decode("utf-8", "replace")
                    bubs[k.rsplit(":", 1)[-1]] = v
            except Exception: pass
            for h in hdrs:
                b = jload(bubs.get(h.get("bubbleId")))
                t = bub_text(b) if b else ""
                if t: msgs.append(("user" if h.get("type") == 1 else "cursor", t, ""))
        return msgs[-limit:], (d.get("name") or "")
    finally:
        con.close()
        if td: shutil.rmtree(td, ignore_errors=True)

def tab_messages(wdb, tid, limit):
    con, td = db_ro(wdb)
    try:
        msgs = []; title = ""
        for (v,) in con.execute(
                "select value from ItemTable where key='workbench.panel.aichat.view.aichat.chatdata'"):
            dd = jload(v)
            if not isinstance(dd, dict): continue
            for tab in dd.get("tabs") or []:
                if str(tab.get("tabId")) != tid: continue
                title = tab.get("chatTitle") or ""
                for b in tab.get("bubbles") or []:
                    t = bub_text(b)
                    if t: msgs.append(("user" if b.get("type") == "user" else "cursor", t, ""))
        return msgs[-limit:], title
    finally:
        con.close()
        if td: shutil.rmtree(td, ignore_errors=True)

def cj_messages(f, limit):
    msgs = []
    try:
        with open(f, "rb") as fh: lines = fh.read().split(b"\n")
    except OSError:
        return msgs
    for b in lines:
        d = jload(b)
        if not d or d.get("role") not in ("user", "assistant"): continue
        t = cursor_msg_text({"role": d.get("role"), "content": (d.get("message") or {}).get("content")})
        if t: msgs.append(("user" if d["role"] == "user" else "cursor", t, ""))
    return msgs[-limit:]

def get_messages(ref, limit):
    typ, path, rid = ref.split("|", 2)
    title = ""
    if typ == "cc": msgs = cc_messages(path, limit)
    elif typ == "cs": msgs = store_messages(path, limit)
    elif typ == "ca": msgs, title = composer_messages(path, rid, limit)
    elif typ == "cl": msgs, title = tab_messages(path, rid, limit)
    elif typ == "cj": msgs = cj_messages(path, limit)
    else: msgs = []
    return typ, path, rid, msgs, title

def cc_own_title(path):
    try:
        head, tail = head_tail(path, 300, 262144)
    except OSError:
        return ""
    ai = cu = summ = ""
    for b in list(head) + list(tail):
        d = jload(b)
        if not d: continue
        t = d.get("type")
        if t == "custom-title" and d.get("customTitle"): cu = d["customTitle"]
        elif t == "ai-title" and d.get("aiTitle"): ai = d["aiTitle"]
        elif t == "summary" and d.get("summary") and not summ: summ = d["summary"]
    return cu or ai or summ

def do_details_json(ref, query=""):
    """Structured transcript for non-human consumers: no ANSI, no truncation of message text,
    chronological order, and an explicit flag on which messages matched the query."""
    terms = qterms(query)
    LIM = 2000
    try:
        typ, path, rid, msgs, title = get_messages(ref, LIM)
    except Exception as e:
        json.dump({"ref": ref, "error": str(e)}, sys.stdout); print()
        sys.exit(1)
    if typ == "cc" and not title: title = cc_own_title(path)
    try: mt = os.path.getmtime(path)
    except OSError: mt = 0
    out = {
        "ref": ref, "type": typ, "path": path, "id": rid, "title": title or "",
        "updated": fmt_ts(mt), "updated_iso": iso_ts(mt),
        "query": query, "message_count": len(msgs),
        "truncated": len(msgs) >= LIM,          # older messages exist beyond this window
        "order": "chronological",
        "messages": [{"role": r_, "text": t, "ts": ts,
                      "matched": bool(terms) and any(x in t.lower() for x in terms)}
                     for r_, t, ts in msgs],
    }
    out["match_count"] = sum(1 for m in out["messages"] if m["matched"])
    json.dump(out, sys.stdout, ensure_ascii=False)
    print()

def do_details(ref, query="", mode=""):
    if mode == "json":
        return do_details_json(ref, query)
    terms = qterms(query)
    # With a query, look deeper than the last 14 messages — a --content hit is usually
    # mid-conversation, and a preview that can't show why it matched is useless.
    try:
        typ, path, rid, msgs, title = get_messages(ref, 400 if terms else 14)
    except Exception as e:
        print(f"could not parse ref: {e}"); return
    if typ == "cc" and not title: title = cc_own_title(path)
    names = {"cc": "Claude session (jsonl)", "cs": "Cursor CLI chat", "ca": "Cursor app chat",
             "cl": "Cursor app chat (legacy)", "cj": "Cursor subagent run"}
    try: mt = fmt_ts(os.path.getmtime(path))
    except OSError: mt = "?"
    rx = hl_re(terms)
    print(f"{BOLD}{GR}● {hl(title or names.get(typ, typ), rx, BOLD + GR)}{R}")
    sub = (f"{names.get(typ, typ)} · " if title else "") + f"updated {mt}"
    print(f"{DIM}   {sub}{R}")
    print(f"{DIM}   id     {R}{rid}")
    print(f"{DIM}   file   {R}{path}")

    msgs = list(reversed(msgs))                     # newest first
    hits = [i for i, m in enumerate(msgs) if terms and any(t in m[1].lower() for t in terms)]

    def show(items):
        for i in items:
            role, t, ts = msgs[i]
            col = CY if role == "user" else MG
            who = "you" if role == "user" else role
            t = re.sub(r"\n{3,}", "\n\n", t.strip())
            t = snip(t, terms) if i in hits else (t[:700] + " …" if len(t) > 700 else t)
            print(f"{col}{BOLD}▌ {who}{R}{DIM}{(' · ' + ts) if ts else ''}{R}")
            print(hl(t, rx))
            print()

    if not msgs:
        print(f"{DIM}{'─' * 34} latest message first ▼{R}")
        print(f"{DIM}(no displayable messages){R}")
        return

    lead = []
    if terms:
        if hits:
            lead = hits[:6]
            more = f" (+{len(hits) - len(lead)} more)" if len(hits) > len(lead) else ""
            print(f"{DIM}{'─' * 22} {len(hits)} message(s) mentioning "
                  f"{HL}{query}{R}{DIM} (any word){more}, newest first ▼{R}")
            show(lead)
            print(f"{DIM}{'─' * 30} rest of the conversation ▼{R}")
        else:
            print(f"{DIM}{'─' * 12} no message matches {HL}{query}{R}{DIM} — "
                  f"it matched the title, project or id ▼{R}")
    else:
        print(f"{DIM}{'─' * 34} latest message first ▼{R}")
    show([i for i in range(min(14, len(msgs))) if i not in lead])

def do_export(ref, dest=""):
    LIM = 2000
    typ, path, rid, msgs, title = get_messages(ref, LIM)
    if typ == "cc" and not title: title = cc_own_title(path)
    if not title and msgs:
        title = next((t for r_, t, _ in msgs if r_ == "user"), msgs[0][1])[:60]
    def write(f):
        f.write(f"# {title or 'Transcript'}\n\n- source: `{path}`\n- id: `{rid}`\n"
                f"- messages: {len(msgs)}{' (older ones truncated)' if len(msgs) >= LIM else ''}\n"
                f"\n---\n\n")
        for role, t, ts in msgs:
            f.write(f"### {role}{(' — ' + ts) if ts else ''}\n\n{t.strip()}\n\n---\n\n")
    if dest == "-":                       # straight to stdout: no temp file for callers to clean up
        write(sys.stdout); return
    if dest:
        out = os.path.abspath(os.path.expanduser(dest))
        if os.path.isdir(out):
            out = os.path.join(out, f"transcript-{typ}-{rid[:8]}.md")
    else:
        dl = os.path.join(HOME, "Downloads")
        if not os.path.isdir(dl): dl = tempfile.gettempdir()
        slug = re.sub(r"[^A-Za-z0-9]+", "-", (title or "transcript"))[:40].strip("-") or "transcript"
        out = os.path.join(dl, f"transcript-{typ}-{rid[:8]}-{slug}.md")
    with open(out, "w") as f: write(f)
    print(out)

