def cache_save():
    if not _cache_dirty: return
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w") as f: json.dump(_cache, f)
        os.replace(tmp, CACHE_FILE)
    except Exception: pass

def mkrow(agent, src, sid, name, role, last, ts, path, ref, proj):
    return {"a": agent, "s": src, "i": sid, "n": clean(name, 200), "r": role,
            "l": clean(last, 300), "z": tailof(last, 300),
            "t": float(ts or 0), "p": path, "f": ref, "j": clean(proj, 60)}

# ------------------------------------------------------------- sqlite helper
def db_ro(path):
    try:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=0.8)
        con.execute("select 1 from sqlite_master limit 1").fetchone()
        return con, None
    except Exception:
        pass
    try:
        if os.path.getsize(path) > 2_000_000_000:
            raise Exception("db locked and too large to copy")
    except OSError: pass
    td = tempfile.mkdtemp(prefix="trx-")
    for ext in ("", "-wal", "-shm"):
        s = path + ext
        if os.path.exists(s):
            try: shutil.copy2(s, os.path.join(td, "db" + ext))
            except Exception: pass
    con = sqlite3.connect(f"file:{os.path.join(td,'db')}?mode=ro", uri=True)
    return con, td

# ------------------------------------------------------------- claude jsonl
CC_SKIP = ("<command-name>", "<command-message>", "<local-command", "Caveat: The messages below",
           "<system-reminder", "[Request interrupted")

def blk_text(content):
    if isinstance(content, str): return content
    if isinstance(content, list):
        out = []
        for p in content:
            if isinstance(p, dict) and p.get("type") == "text" and p.get("text"):
                out.append(p["text"])
        return "\n".join(out)
    return ""

def cc_line_text(d):
    if d.get("isMeta"): return None
    m = d.get("message") or {}
    t = blk_text(m.get("content")).strip()
    if not t: return None
    for p in CC_SKIP:
        if t.startswith(p): return None
    mm = re.search(r"<user_query>\s*(.*?)\s*</user_query>", t, re.S)
    if mm: t = mm.group(1).strip()
    return t or None

NOISE_PREFIX = ("This session is being continued from a previous conversation",
                "Caveat:", "[Request interrupted")

def is_noise(t):
    """True for texts that make terrible titles/last-messages (tag blobs, compaction preambles)."""
    ts = t.lstrip()
    if ts.startswith("<"): return True
    return any(ts.startswith(p) for p in NOISE_PREFIX)

def strip_tags(t):
    return clean(re.sub(r"<[^>]{1,120}>", " ", t))

def head_tail(f, n_head=250, tail_bytes=262144):
    head = []
    with open(f, "rb") as fh:
        for i, l in enumerate(fh):
            if i >= n_head: break
            head.append(l)
        fh.seek(0, 2); size = fh.tell()
        fh.seek(max(0, size - tail_bytes))
        tail = fh.read().split(b"\n")
    return head, tail

def _user_homes():
    """This user's home + any other readable account homes (multi-account machines).
    An explicit TRANSCRIPTS_HOME means "look only here" — used by tests and by anyone
    pointing the tool at a copied/mounted home."""
    if os.environ.get("TRANSCRIPTS_HOME"): return [HOME]
    homes = [HOME]
    for pat in ("/Users/*", "/home/*"):
        for h in glob.glob(pat):
            try:
                if os.path.realpath(h) != os.path.realpath(HOME) and os.path.isdir(h) \
                   and os.access(h, os.R_OK | os.X_OK):
                    homes.append(h)
            except OSError: pass
    return homes

def claude_files():
    files = []
    for h in _user_homes():
        for r in (os.path.join(h, ".claude", "projects"),
                  os.path.join(h, ".config", "claude", "projects")):
            try: files += glob.glob(os.path.join(r, "*", "*.jsonl"))
            except OSError: pass
        lam = os.path.join(h, "Library", "Application Support", "Claude", "local-agent-mode-sessions")
        if os.path.isdir(lam):
            try: files += glob.glob(os.path.join(lam, "**", "*.jsonl"), recursive=True)
            except OSError: pass
    seen, out = set(), []
    for f in files:
        rp = os.path.realpath(f)
        if rp not in seen:
            seen.add(rp); out.append(rp)
    return out

def parse_cc(f, st):
    """Returns {"r": row_or_None, "x": aux}; aux carries summary lines + uuid samples + cwd."""
    head, tail = head_tail(f, 300, 524288)
    name = cwd = None
    own = 0            # 1 = summary/title record, 2 = chat-window title (ai-title/custom-title)
    ai_t = cu_t = None # window titles seen in head (keep newest = last)
    first_c = first_n = None
    sums = {}          # leafUuid -> summary text (found in THIS file)
    head_ids = []      # sampled uuid/parentUuid, oldest first
    for b in head:
        d = jload(b)
        if not d: continue
        t = d.get("type")
        if t == "ai-title":
            v = d.get("aiTitle")
            if isinstance(v, str) and v.strip(): ai_t = v.strip()
            continue
        if t == "custom-title":
            v = d.get("customTitle")
            if isinstance(v, str) and v.strip(): cu_t = v.strip()
            continue
        if t == "summary":
            if d.get("leafUuid"): sums[d["leafUuid"]] = d.get("summary") or ""
            if not name and d.get("summary"): name, own = d["summary"], 1
            continue
        if not name:
            for k in ("title", "sessionTitle", "session_title"):
                v = d.get(k)
                if isinstance(v, str) and 2 < len(v.strip()) < 200:
                    name, own = v.strip(), 1; break
        if not cwd and d.get("cwd"): cwd = d["cwd"]
        if t in ("user", "assistant") and not d.get("isSidechain"):
            for k in ("uuid", "parentUuid"):
                if d.get(k): head_ids.append(d[k])
            if t == "user" and not first_c:
                x = cc_line_text(d)
                if x:
                    if is_noise(x): first_n = first_n or x
                    else: first_c = x
    last_c = last_n = None; role_c = role_n = ""
    tai = tcu = None   # window titles seen in tail (reversed scan → first hit is newest)
    tail_ids = []      # newest first
    for b in reversed(tail):
        d = jload(b)
        if not d: continue
        t = d.get("type")
        if t == "ai-title" and tai is None:
            v = d.get("aiTitle")
            if isinstance(v, str) and v.strip(): tai = v.strip()
            continue
        if t == "custom-title" and tcu is None:
            v = d.get("customTitle")
            if isinstance(v, str) and v.strip(): tcu = v.strip()
            continue
        if t == "summary":
            if d.get("leafUuid"): sums.setdefault(d["leafUuid"], d.get("summary") or "")
            continue
        if t not in ("user", "assistant") or d.get("isSidechain"): continue
        if not cwd and d.get("cwd"): cwd = d["cwd"]
        for k in ("uuid", "parentUuid"):
            if d.get(k): tail_ids.append(d[k])
        if last_c is None:
            x = cc_line_text(d)
            if x:
                r_ = "user" if t == "user" else "claude"
                if is_noise(x):
                    if last_n is None: last_n, role_n = x, r_
                else: last_c, role_c = x, r_
    win = (tcu or cu_t) or (tai or ai_t)   # actual chat-window name; custom > ai, newest wins
    if win: name, own = win, 2
    first = first_c or (strip_tags(first_n) if first_n else None)
    last = last_c or (strip_tags(last_n) if last_n else None)
    role = role_c or role_n
    aux = {"s": sums, "hi": head_ids[:60], "ti": tail_ids[:120], "c": cwd or "", "ow": own}
    if not (name or first or last):
        return {"r": None, "x": aux}
    slug = os.path.basename(os.path.dirname(f))
    cowork = "local-agent-mode-sessions" in (cwd or "") or "local-agent-mode-sessions" in slug \
             or "local-agent-mode-sessions" in f
    sid = os.path.splitext(os.path.basename(f))[0]
    if cowork:
        m = re.search(r"local_([0-9a-f]{8})", (cwd or "") + " " + slug + " " + f)
        proj = "cowork:" + m.group(1) if m else "cowork"
        src = "cwrk"
    else:
        proj = os.path.basename(cwd) if cwd else (slug.rsplit("-", 1)[-1] or slug)
        src = "code"
    row = mkrow("claude", src, sid, name or first or "(untitled)", role, last or "",
                st.st_mtime, f, f"cc|{f}|{sid}", proj)
    return {"r": row, "x": aux}

def _title_walk(d, out, depth=0):
    """Harvest sessionId->title pairs from arbitrary JSON structures."""
    if depth > 6: return
    if isinstance(d, dict):
        sid = tit = None
        for k, v in d.items():
            kl = (k or "").lower()
            if re.fullmatch(r"[0-9a-fA-F-]{32,40}", k or ""):     # {"<uuid>": "title"} / {"<uuid>": {...}}
                if isinstance(v, str) and 2 < len(v.strip()) < 200:
                    out.setdefault(k, v.strip())
                elif isinstance(v, dict):
                    for tk in ("title", "summary", "name", "displayName", "display_name"):
                        tv = v.get(tk)
                        if isinstance(tv, str) and 2 < len(tv.strip()) < 200:
                            out.setdefault(k, tv.strip()); break
            if not isinstance(v, str): continue
            if kl in ("sessionid", "session_id", "id", "uuid") and re.fullmatch(r"[0-9a-fA-F-]{8,}", v):
                sid = sid or v
            if kl in ("title", "summary", "name", "displayname", "display_name") and 2 < len(v.strip()) < 200:
                tit = tit or v.strip()
        if sid and tit: out.setdefault(sid, tit)
        for v in d.values(): _title_walk(v, out, depth + 1)
    elif isinstance(d, list):
        for v in d[:2000]: _title_walk(v, out, depth + 1)

def external_claude_titles():
    """sessionId -> title from any index json + __store.db in every readable account's config."""
    out = {}
    roots = []
    for h in _user_homes():
        roots += [os.path.join(h, ".claude"), os.path.join(h, ".config", "claude")]
    for r_ in roots:
        if not os.path.isdir(r_): continue
        pats = [os.path.join(r_, "projects", "*", "*.json"),
                os.path.join(r_, "projects", "*.json"),
                os.path.join(r_, "*.json")]
        for pat in pats:
            for jf in glob.glob(pat):
                try:
                    if os.path.getsize(jf) > 2_000_000: continue
                    with open(jf) as fh: _title_walk(json.load(fh), out)
                except Exception: pass
        db = os.path.join(r_, "__store.db")
        if not os.path.exists(db): continue
        try: con, td = db_ro(db)
        except Exception: continue
        try:
            for (tn,) in con.execute("select name from sqlite_master where type='table'"):
                try: cols = [c[1] for c in con.execute(f'pragma table_info("{tn}")')]
                except Exception: continue
                idc = next((c for c in cols if c.lower() in ("session_id", "sessionid", "conversation_id", "uuid", "id")), None)
                tc  = next((c for c in cols if c.lower() in ("summary", "title", "name", "display_name")), None)
                if not idc or not tc: continue
                try:
                    for i_, t_ in con.execute(f'select "{idc}","{tc}" from "{tn}"'):
                        if isinstance(i_, str) and isinstance(t_, str) and t_.strip():
                            out.setdefault(i_, t_.strip())
                except Exception: pass
        finally:
            con.close()
            if td: shutil.rmtree(td, ignore_errors=True)
    return out

def _sidecar_title(sdir, _cache={}):
    """Best-effort title from small json files in a Cowork session dir."""
    if sdir in _cache: return _cache[sdir]
    tit = None
    def find(d, depth=0):
        if depth > 5: return None
        if isinstance(d, dict):
            for k in ("title", "conversationTitle", "sessionTitle", "summary"):
                v = d.get(k)
                if isinstance(v, str) and 2 < len(v.strip()) < 200: return v.strip()
            for v in d.values():
                r = find(v, depth + 1)
                if r: return r
        elif isinstance(d, list):
            for v in d[:200]:
                r = find(v, depth + 1)
                if r: return r
        return None
    try:
        for jf in sorted(glob.glob(os.path.join(sdir, "*.json"))):
            if os.path.getsize(jf) > 1_000_000: continue
            try:
                with open(jf) as fh: tit = find(json.load(fh))
            except Exception: continue
            if tit: break
    except Exception: pass
    _cache[sdir] = tit
    return tit

TITLE_STATS = {"window": 0, "map": 0, "own": 0, "ext": 0, "sidecar": 0, "deep": 0, "fallback": 0}
UNTITLED_SAMPLES = []

def deep_title_scan(path, summap):
    """Bounded full-file scan: prefer mid-file ai-title/custom-title lines, else the newest
    known summary leafUuid, collecting extra summary records on the way.
    Returns (title_or_None, bytes_scanned)."""
    try: size = os.path.getsize(path)
    except OSError: return None, 0
    keys = [k for k in summap if k and re.fullmatch(r"[0-9a-fA-F-]{32,40}", k)]
    rx = re.compile(b"|".join(re.escape(k.encode()) for k in keys)) if keys else None
    CAP = 33_554_432
    regions = [(0, size)] if size <= 2 * CAP else [(0, CAP), (size - CAP, CAP)]
    found = None; scanned = 0
    tkind = ""; ttext = None            # window title: custom beats ai, later beats earlier
    try:
        with open(path, "rb") as fh:
            for off, ln in regions:
                fh.seek(off); data = fh.read(ln); scanned += len(data)
                if b'"ai-title"' in data or b'"custom-title"' in data:
                    for line in data.split(b"\n"):
                        if b'"ai-title"' not in line and b'"custom-title"' not in line: continue
                        d = jload(line)
                        if not d: continue
                        if d.get("type") == "custom-title" and d.get("customTitle"):
                            tkind, ttext = "c", d["customTitle"]
                        elif d.get("type") == "ai-title" and d.get("aiTitle") and tkind != "c":
                            tkind, ttext = "a", d["aiTitle"]
                if b'"summary"' in data:
                    for line in data.split(b"\n"):
                        if b'"type":"summary"' in line or b'"type": "summary"' in line:
                            d = jload(line)
                            if d and d.get("leafUuid") and d.get("summary"):
                                summap.setdefault(d["leafUuid"], d["summary"])
                if rx:
                    for m in rx.finditer(data): found = m.group(0)
    except OSError:
        return (ttext, scanned) if ttext else (None, scanned)
    if ttext: return ttext, scanned
    return (summap.get(found.decode()) if found else None), scanned

def scan_claude(rows, errors):
    entries = []
    for f in claude_files():
        try: st = os.stat(f)
        except OSError: continue
        if st.st_size == 0: continue
        ck = f"{f}|{st.st_mtime_ns}|{st.st_size}"
        c = cache_get(ck)
        if c is None:
            try: c = parse_cc(f, st)
            except Exception as e:
                errors.append(f"{f}: {e}"); continue
            cache_put(ck, c)
        if not (isinstance(c, dict) and "x" in c):
            c = {"r": c or None, "x": {"s": {}, "hi": [], "ti": [], "c": ""}}
        entries.append((ck, c))
    summap = {}
    for _ck, e in entries:
        for k, v in (e["x"].get("s") or {}).items():
            if v: summap[k] = v
    ext = external_claude_titles() if entries else {}
    untitled = []
    for ck, e in entries:
        r = e["r"]
        if not r: continue
        x = e["x"]
        if x.get("ow") == 2:            # real chat-window name found in-file — authoritative
            TITLE_STATS["window"] += 1
            rows.append(r); continue
        title = how = None
        for u in (x.get("ti") or []):               # newest first
            if u in summap: title, how = summap[u], "map"; break
        if not title:
            for u in reversed(x.get("hi") or []):
                if u in summap: title, how = summap[u], "map"; break
        if not title and ext.get(r["i"]): title, how = ext[r["i"]], "ext"
        if not title and r["s"] == "cwrk" and x.get("c"):
            t = _sidecar_title(os.path.dirname(x["c"].rstrip("/")))
            if t: title, how = t, "sidecar"
        if title:
            if title != r["n"]:
                r["n"] = clean(title, 200); cache_put(ck, e)
            TITLE_STATS[how] += 1
        elif x.get("ow"):
            TITLE_STATS["own"] += 1
        else:
            untitled.append((ck, e))
        rows.append(r)
    # deep pass: bounded whole-file scan for sessions whose summary leaf sits mid-file
    budget = 1_500_000_000
    for ck, e in sorted(untitled, key=lambda t_: -t_[1]["r"]["t"]):
        r, x = e["r"], e["x"]
        if x.get("deep") or budget <= 0:
            TITLE_STATS["fallback"] += 1
            if x.get("deep") and len(UNTITLED_SAMPLES) < 5:
                UNTITLED_SAMPLES.append(r["p"])
            continue
        t, scanned = deep_title_scan(r["p"], summap)
        budget -= max(scanned, 1)
        x["deep"] = 1
        if t:
            r["n"] = clean(t, 200)
            TITLE_STATS["deep"] += 1
        else:
            TITLE_STATS["fallback"] += 1
            if len(UNTITLED_SAMPLES) < 5: UNTITLED_SAMPLES.append(r["p"])
        cache_put(ck, e)

