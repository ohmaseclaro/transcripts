#!/usr/bin/env bash
# transcripts — unified TUI browser for Cursor & Claude chat transcripts on this machine.
#
# Sources scanned:
#   claude·code   ~/.claude/projects/**/*.jsonl        (Claude Code CLI + desktop-app Code sessions)
#   claude·cwrk   same store, sessions whose cwd is a Cowork session dir (+ direct scan of the
#                 Claude app's local-agent-mode-sessions folder for any *.jsonl)
#   cursor·app    ~/Library/Application Support/Cursor/User/**/state.vscdb (composers + legacy chat tabs)
#   cursor·cli    ~/.cursor/chats/*/*/store.db          (cursor-agent CLI)
#   cursor·sub    cursor subagent transcripts (hidden unless --subagents)
#
# Usage:  (value flags accept both forms: --flag value and --flag=value)
#   transcripts                        # agent picker, then TUI
#   transcripts --agent cursor         # only cursor (also: claude, all) · short: -a
#   transcripts --query "oauth bug"    # start pre-filtered · short: -q
#   transcripts --list                 # NON-INTERACTIVE: pretty table on a terminal,
#                                      #   raw TSV when piped (id, source, updated, title,
#                                      #   last message head, last message tail, path)
#                                      #   · combines with --agent/--query/
#                                      #   --subagents · shows last 24h by default
#   transcripts --json                 # same rows, one JSON object per line
#   transcripts --table | --tsv        # force the pretty table / force raw TSV
#   transcripts --list --since 10d     # look-back window: Nd / Nh / Nm · short: -s
#   transcripts --list --full-list     # no time window: list everything
#   transcripts --subagents            # include cursor subagent/background transcripts (no short)
#   transcripts --details 'REF'        # print detail view for a ref
#   transcripts --doctor               # show what was found where (debugging)
#   transcripts --install              # symlink into ~/.local/bin + add to PATH
#
# Searching:
#   A query is split on whitespace and EVERY word must match (case-insensitive substring).
#   By default only cached metadata is searched — title, project, session id, and the first
#   and last 300 chars of the newest message. That is instant but shallow.
#     transcripts -q "oauth bug" --list          # metadata only (fast)
#     transcripts -q oauth --content --list      # also read the conversations (slow)
#     transcripts -q oauth -c -s 7d --scan 800   # narrow the window, scan deeper
#   --content/-c opens each non-matching transcript and searches the messages themselves.
#   It stops after --scan transcripts (default 300, newest first) and says so on stderr.
#   Giving a query drops the implicit 24h window: -q searches all time unless --since says
#   otherwise. Typing in the TUI uses the same rule (fzf --exact over the same text), so the
#   list, the table and the TUI all agree on what a query means.
#
# Keys (fzf mode): type=filter · enter=pick (copies path) · tab=show/hide transcript pane
#                  ctrl-f=search inside transcripts (--content on what you typed)
#                  ctrl-a=switch agent · ctrl-e=export markdown · ctrl-y=copy path · ctrl-r=refresh
