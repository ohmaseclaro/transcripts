def warn(msg):
    """Diagnostics go to stderr — except under `index`, whose output feeds an fzf reload and
    whose stderr would be painted over the live TUI."""
    if CMD != "index": sys.stderr.write(msg)

def _filter_rows(agent, query, include_sub, since_spec, content=False, dirspec=""):
    """The single filter, in cost order: time window, then directory scope, then the cached
    metadata query, and only then --content (which opens transcripts off disk)."""
    secs = since_seconds(since_spec)
    cutoff = (time.time() - secs) if secs is not None else None
    target = norm_dir(dirspec) if dirspec else ""
    rows, errors = collect(agent, include_sub)
    terms = qterms(query)
    sel = []
    scanned = skipped = 0
    for r in rows:
        if cutoff is not None and r["t"] < cutoff:
            break        # rows are sorted newest-first
        if target and not under_dir(r, target):
            continue
        if not terms or qmatch(terms, row_hay(r)):
            sel.append(r)
            continue
        if not content:
            continue
        if scanned >= SCAN_CAP:
            skipped += 1     # never silently truncate — reported below
            continue
        scanned += 1
        if qmatch(terms, body_text(r)):
            sel.append(r)
    if skipped:
        warn(f"transcripts: --content read the {scanned} newest transcripts; {skipped} older ones "
             f"were NOT searched. Narrow with --since/--agent/--dir, or raise --scan "
             f"(default {SCAN_CAP}).\n")
    if errors:
        warn(f"transcripts: {len(errors)} store(s) could not be read "
             f"(--doctor lists them); results may be incomplete.\n")
    return sel, secs

def _pad(s, w):
    return pad_w(clean(s), w)

def _pad_end(s, w):
    s = clean(s)
    if dwidth(s) > w: s = "…" + clip_w_end(s, w - 1)
    return s + " " * max(0, w - dwidth(s))

def clip_w_end(s, n):
    """Keep the LAST n display columns of s."""
    if n <= 0: return ""
    out, w = [], 0
    for ch in reversed(s):
        cw = dwidth(ch)
        if w + cw > n: break
        out.append(ch); w += cw
    return "".join(reversed(out))

def wrap_w(s, n):
    """Wrap to n display columns. Long unbroken tokens (paths!) are hard-split rather than
    allowed to overflow, so nothing ever needs truncating to fit."""
    if n < 4: return [s]
    out, line = [], ""
    for word in s.split(" "):
        while dwidth(word) > n:
            take = ""
            for ch in word:
                if dwidth(take + ch) > n: break
                take += ch
            if not take: break
            if line: out.append(line); line = ""
            out.append(take); word = word[len(take):]
        if not word: continue
        if not line: line = word
        elif dwidth(line) + 1 + dwidth(word) <= n: line += " " + word
        else: out.append(line); line = word
    if line: out.append(line)
    return out or [""]

def disp_path(p):
    """Home-relative so it stays short and still pastes into a shell."""
    home = os.path.expanduser("~")
    return "~" + p[len(home):] if p.startswith(home) else p

def emit_cards(sel, width, headline, nomatch):
    """Narrow terminals: the boxed table squeezes every column into uselessness and clips the
    path, which is the one thing you actually need. One block per session instead."""
    print(headline)
    if not sel:
        print(nomatch); return
    for r in sel:
        tag = f'{r["a"]}·{r["s"]}'
        meta = f'{tag} · {time.strftime("%d %b %H:%M", time.localtime(r["t"]))} · {r["i"][:8]}'
        if r["j"]: meta += f' · {r["j"]}'
        pfx = ("you" if r["r"] == "user" else r["r"]) + ": " if r["r"] else ""
        for i, l in enumerate(wrap_w(clean(r["n"]) or "(untitled)", width - 2)):
            print(f'{BOLD}{"● " if i == 0 else "  "}{l}{R}')
        print(f"{DIM}  {clip_w(meta, width - 2)}{R}")
        for l in wrap_w(clean(pfx + r["l"]), width - 4)[:2]:
            print(f"  {l}")
        for i, l in enumerate(wrap_w(disp_path(r["p"]), width - 4)):
            print(f'{DIM}  {"⤷" if i == 0 else " "} {R}{l}')
        print()

def emit_table(agent, query, include_sub, since_spec, content=False, dirspec=""):
    sel, secs = _filter_rows(agent, query, include_sub, since_spec, content, dirspec)
    try: width = os.get_terminal_size(sys.__stdout__.fileno()).columns
    except Exception:
        try: width = int(os.environ.get("COLUMNS") or 120)
        except ValueError: width = 120
    IDW, SRW, UPW = 8, 11, 12
    # Narrow terminals used to get a 110-column table that wrapped into unreadable garbage.
    # Drop the tail column first, then the id, rather than overflowing.
    w_desc0 = "all time" if secs is None else f"last {(since_spec or '').strip().lower()}"
    scope0 = f" · dir: {norm_dir(dirspec)}" if dirspec else ""
    headline = DIM + "\n".join(wrap_w(
        f"transcripts · agent={agent} · {w_desc0} · {len(sel)} shown"
        f"{(' · filter: ' + query) if query else ''}{scope0}"
        f"{' · content' if content else ''}", max(20, width))) + R
    if width < 88:
        return emit_cards(sel, width, headline,
                          no_match_hint(query, since_spec, content, dirspec))
    cols = ["ID", "SOURCE", "UPDATED", "TITLE", "LAST MESSAGE HEAD", "LAST MESSAGE TAIL"]
    show_tail = width >= 118
    show_id = width >= 100
    if not show_tail: cols.remove("LAST MESSAGE TAIL")
    if not show_id: cols.remove("ID")
    nsep = 3 * len(cols) + 1
    fixed = (IDW if show_id else 0) + SRW + UPW
    flex = max(30, width - nsep - fixed)
    if show_tail:
        TW = max(16, int(flex * 0.30)); HW = max(14, int(flex * 0.36)); ZW = max(14, flex - TW - HW)
    else:
        TW = max(16, int(flex * 0.42)); HW = max(14, flex - TW); ZW = 0
    widths = ([IDW] if show_id else []) + [SRW, UPW, TW, HW] + ([ZW] if show_tail else [])
    W = sum(widths) + nsep
    def hline(lft, mid, rgt):
        return DIM + lft + mid.join("─" * (w + 2) for w in widths) + rgt + R
    sep = DIM + "│" + R
    out = [headline,
           hline("┌", "┬", "┐"),
           sep + sep.join(f" {BOLD}{_pad(h, w)}{R} " for h, w in zip(cols, widths)) + sep,
           hline("├", "┼", "┤")]
    for r in sel:
        tag = f'{r["a"]}·{r["s"]}'
        pfx = ("you" if r["r"] == "user" else r["r"]) + ": " if r["r"] else ""
        cells = ([DIM + _pad(r["i"][:8], IDW) + R] if show_id else []) + [
                 (TAGC.get(tag, "")) + _pad(tag, SRW) + R,
                 _pad(time.strftime("%d %b %H:%M", time.localtime(r["t"])), UPW),
                 BOLD + _pad(r["n"], TW) + R,
                 _pad(pfx + r["l"], HW)]
        if show_tail:
            cells.append(_pad_end(tail_disp(r["l"], r.get("z") or "", max(1, HW - len(pfx)), ZW), ZW))
        out.append(sep + sep.join(f" {c} " for c in cells) + sep)
        # The path is the payload — never clip it. It wraps across as many boxed lines as it
        # needs, so a deep project slug stays copy-pasteable on any terminal width.
        pw = W - 6
        for i, line in enumerate(wrap_w(disp_path(r["p"]), pw)):
            mark = "⤷" if i == 0 else " "
            out.append(f'{DIM}│ {mark} {R}{line}{" " * max(0, pw - dwidth(line))}{DIM} │{R}')
    out.append(hline("└", "┴", "┘"))
    if not sel:
        out.append(no_match_hint(query, since_spec, content, dirspec))
    print("\n".join(out))

def no_match_hint(query, since_spec, content, dirspec):
    """Say which filter is the likely culprit instead of always blaming the time window."""
    bits = []
    if dirspec: bits.append(f"--dir {norm_dir(dirspec)}")
    if query: bits.append(f'query "{query}"')
    if since_seconds(since_spec) is not None: bits.append(f"--since {since_spec}")
    what = " + ".join(bits) if bits else "these filters"
    tip = "try --full-list" if since_seconds(since_spec) is not None else ""
    if query and not content:
        tip = (tip + " · " if tip else "") + "--content searches inside the transcripts"
    return f"nothing matches {what}" + (f" — {tip}" if tip else "")

def emit_plain(agent, query, include_sub, as_json, since_spec, content=False, dirspec=""):
    sel, _secs = _filter_rows(agent, query, include_sub, since_spec, content, dirspec)
    for r in sel:
        if as_json:
            print(json.dumps({"id": r["i"], "source": f'{r["a"]}·{r["s"]}',
                              "agent": r["a"], "store": r["s"],
                              "updated": fmt_ts(r["t"]), "updated_ts": int(r["t"]),
                              "updated_iso": iso_ts(r["t"]),
                              "title": r["n"], "project": r["j"], "dir": r.get("d") or "",
                              "subagent": r["s"] == "sub", "last_role": r["r"],
                              "last_message_head": r["l"],
                              "last_message_tail": r.get("z") or "",
                              "path": r["p"], "ref": r["f"]}, ensure_ascii=False))
        else:
            print("\t".join(esc(x) for x in (
                r["i"], f'{r["a"]}·{r["s"]}', fmt_ts(r["t"]), clean(r["n"], 80),
                clean(r["l"], 160), tail_disp(r["l"], r.get("z") or "", 160, 160),
                r.get("d") or "", r["p"])))

if CMD == "index":
    emit_index(ARG1 or "all", ARG2, ARG3 == "1", ARG4 == "1", ARG5)
elif CMD == "list":
    emit_plain(ARG1 or "all", ARG2, ARG3 == "1", False, ARG4, ARG5 == "1", ARG6)
elif CMD == "json":
    emit_plain(ARG1 or "all", ARG2, ARG3 == "1", True, ARG4, ARG5 == "1", ARG6)
elif CMD == "table":
    emit_table(ARG1 or "all", ARG2, ARG3 == "1", ARG4, ARG5 == "1", ARG6)
elif CMD == "legend":
    print(f'{DIM}{"AGE":>4} {"SOURCE":<11} {"ID":<8} {"TITLE":<44} {"PROJECT":<16} {"FROM":>6}  LAST MESSAGE HEAD ⋯ TAIL{R}')
elif CMD == "details":
    do_details(ARG1, ARG2, ARG3)
elif CMD == "export":
    do_export(ARG1, ARG2)
elif CMD == "doctor":
    do_doctor(True)
elif CMD == "path":
    print(ARG1.split("|", 2)[1])
else:
    sys.exit(f"unknown internal command: {CMD}")
PYCODE
}

# ---------------------------------------------------------------- helpers
ref_path() { local r="${1#*|}"; printf '%s' "${r%|*}"; }   # handles '|' inside the path

copy_ref_path() {
  local p; p="$(ref_path "$1")"
  printf '%s' "$p" | _clip 2>/dev/null
}

# STATE file: line 1 = agent, line 2 = sticky query (what ctrl-f last searched for). The
# sticky query exists because ctrl-f clears fzf's own query — without it the preview would
# have nothing to highlight on exactly the search that needed highlighting most.
state_agent() { local a; a="$(sed -n 1p "$1" 2>/dev/null)"; printf '%s' "${a:-all}"; }
state_query() { sed -n 2p "$1" 2>/dev/null; }
write_state() { printf '%s\n%s\n' "$2" "$3" > "$1"; }   # write_state STATE AGENT QUERY

cycle_state() { # STATE -> writes next agent, prints nothing
  local cur next
  cur="$(state_agent "$1")"
  case "$cur" in
    all) next=claude ;;
    claude) next=cursor ;;
    *) next=all ;;
  esac
  write_state "$1" "$next" "$(state_query "$1")"
}

do_install() {
  local dest="$HOME/.local/bin/transcripts"
  mkdir -p "$HOME/.local/bin"
  chmod +x "$SELF"
  if [ "$SELF" != "$dest" ]; then ln -sf "$SELF" "$dest"; fi
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *)
      for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        [ -f "$rc" ] || [ "$rc" = "$HOME/.zshrc" ] || continue
        if ! grep -qs 'transcripts-path' "$rc" && ! grep -qs '\.local/bin' "$rc"; then
          printf '\nexport PATH="$HOME/.local/bin:$PATH" # added by transcripts-path\n' >> "$rc"
          echo "added ~/.local/bin to PATH in $rc"
        fi
      done
      ;;
  esac
  echo "installed: $dest -> $SELF"
  echo "open a new shell (or: export PATH=\"\$HOME/.local/bin:\$PATH\") and run: transcripts"
}

# print the header comment block, however long it grows
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; }

# ---------------------------------------------------------------- arg parsing
AGENT="" QUERY="" SUB=0 CMD="" MODE="" SINCE="" CONTENT=0 DIR="" ACTION="" ACTARG="" OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --agent=*) AGENT="${1#*=}" ;;
    --agent|-a) shift; AGENT="${1:-}" ;;
    --query=*) QUERY="${1#*=}" ;;
    --query|-q) shift; QUERY="${1:-}" ;;
    --dir=*) DIR="${1#*=}" ;;
    --dir|-d) shift; DIR="${1:-}" ;;
    --here) DIR="$PWD" ;;
    --content|-c) CONTENT=1 ;;
    --out=*) OUT="${1#*=}" ;;
    --out|-o) shift; OUT="${1:-}" ;;
    --scan=*) export TRANSCRIPTS_SCAN="${1#*=}" ;;
    --scan) shift; export TRANSCRIPTS_SCAN="${1:-}" ;;
    --list|-l|--print) MODE=list ;;
    --json) MODE=json ;;
    --table) MODE=table ;;
    --tsv) MODE=tsv ;;
    --since=*) SINCE="${1#*=}" ;;
    --since|-s) shift; SINCE="${1:-}" ;;
    --full-list|--all|--full) SINCE=all ;;
    --subagents) SUB=1 ;;
    --install) do_install; exit $? ;;
    # actions run AFTER parsing, so `--details REF -q term` works the same as `-q term --details REF`
    --doctor) ACTION=doctor ;;
    --details) shift; ACTION=details; ACTARG="${1:-}" ;;
    --export) shift; ACTION=export; ACTARG="${1:-}" ;;
    --version) echo "transcripts $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    __index) run_py index "${2:-all}" "${3:-}" "${4:-0}" "${5:-0}" "${6:-}"; exit $? ;;
    __details) # __details REF [QUERY] [STATE] — fall back to the sticky query from ctrl-f
      dq="${3:-}"
      [ -z "$dq" ] && [ -n "${4:-}" ] && dq="$(state_query "$4")"
      run_py details "${2:-}" "$dq"; exit $? ;;
    __export) run_py export "${2:-}" "${3:-}"; exit $? ;;
    __copy) copy_ref_path "${2:-}"; exit 0 ;;
    __reload) # __reload STATE SUB QUERY [next|content] [DIR]
      st="${2:-}"; sb="${3:-0}"; q="${4:-}"; md="${5:-}"; dr="${6:-}"
      [ "$md" = "next" ] && cycle_state "$st"
      # ctrl-f makes the query sticky (for preview highlighting); ctrl-r/ctrl-a clear it
      if [ "$md" = "content" ]; then write_state "$st" "$(state_agent "$st")" "$q"
      else write_state "$st" "$(state_agent "$st")" ""; fi
      run_py index "$(state_agent "$st")" "$q" "$sb" \
        "$([ "$md" = "content" ] && echo 1 || echo 0)" "$dr"; exit $? ;;
    *) echo "transcripts: unknown option $1 (see --help)"; exit 1 ;;
  esac
  shift
done

case "$AGENT" in ""|all|claude|cursor) ;; *) echo "transcripts: --agent must be claude|cursor|all"; exit 1 ;; esac

# A missing directory is worth flagging (usually a typo) but must not be fatal: finding the
# sessions from a project you already deleted is exactly when --dir earns its keep.
if [ -n "$DIR" ] && [ ! -d "$DIR" ]; then
  echo "transcripts: --dir '$DIR' does not exist — matching on the recorded path anyway" >&2
fi

case "$ACTION" in
  doctor)  run_py doctor; exit $? ;;
  details) run_py details "$ACTARG" "$QUERY" "$MODE"; exit $? ;;
  export)  run_py export  "$ACTARG" "$OUT"; exit $? ;;
esac

# ---------------------------------------------------------------- non-interactive list
[ -n "$SINCE" ] && [ -z "$MODE" ] && MODE=list   # --since/--full-list imply --list
# No terminal on stdout means nobody can drive a TUI: `transcripts -q x | head` used to launch
# fzf, fail invisibly and print nothing at all. Piped always means list.
[ -z "$MODE" ] && [ ! -t 1 ] && MODE=list
if [ -n "$MODE" ]; then
  FMT="$MODE"
  if [ "$MODE" = list ]; then                     # auto: pretty table on tty, TSV when piped
    if [ -t 1 ]; then FMT=table; else FMT=list; fi
  elif [ "$MODE" = tsv ]; then FMT=list
  fi
  # searching a 24h window is a surprise, not a default: any explicit filter (a query or a
  # directory scope) means "look everywhere". Only an unfiltered list defaults to recent.
  if [ -z "$SINCE" ]; then
    if [ -n "$QUERY" ] || [ -n "$DIR" ]; then SINCE=all; else SINCE=24h; fi
  fi
  run_py "$FMT" "${AGENT:-all}" "$QUERY" "$SUB" "$SINCE" "$CONTENT" "$DIR"
  exit $?
fi

# ---------------------------------------------------------------- agent picker
if [ -z "$AGENT" ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    if command -v fzf >/dev/null 2>&1 && [ -z "${TRANSCRIPTS_NO_FZF:-}" ]; then
      pick="$(printf 'all      show everything\nclaude   Claude Code + Cowork sessions\ncursor   Cursor app + cursor-agent CLI chats\n' | \
        fzf --prompt='  agent › ' --height=8 --reverse --info=hidden \
            --header='Whose transcripts do you want to browse? (↑↓ + enter, or type)' || true)"
      [ -z "$pick" ] && exit 130
      AGENT="${pick%% *}"
    else
      printf 'Browse which transcripts?  [1] all (default)  [2] claude  [3] cursor : '
      read -r n
      case "$n" in 2) AGENT=claude ;; 3) AGENT=cursor ;; *) AGENT=all ;; esac
    fi
  else
    AGENT=all
  fi
fi

STATE="$(mktemp "${TMPDIR:-/tmp}/transcripts.XXXXXX")"
write_state "$STATE" "$AGENT" "$QUERY"
trap 'rm -f "$STATE"' EXIT

# ---------------------------------------------------------------- fzf TUI
if command -v fzf >/dev/null 2>&1 && [ -z "${TRANSCRIPTS_NO_FZF:-}" ]; then
  SELQ="'$SELF'"
  LEGEND="  $(run_py legend)"
  # ctrl-a cycles the agent, so a fixed prompt string goes stale ("cursor ›" over claude rows).
  # transform-prompt (fzf >= 0.45) re-reads the agent from the state file; older fzf keeps the
  # static prompt rather than dying on an unknown action.
  FZFV="$(fzf --version 2>/dev/null | sed 's/[^0-9.].*//')"
  if [ "$(printf '0.45\n%s\n' "${FZFV:-0}" | sort -V | head -1)" = "0.45" ] && [ -n "$FZFV" ]; then
    PROMPT_BACK="+transform-prompt(printf '  %s › type to filter: ' \"\$(sed -n 1p '$STATE')\")"
    PROMPT_DEEP="+transform-prompt(printf '  %s › matched inside transcripts, refine: ' \"\$(sed -n 1p '$STATE')\")+clear-query"
  else
    PROMPT_BACK="+change-prompt(  › type to filter: )"
    PROMPT_DEEP="+change-prompt(  › matched inside transcripts, refine: )+clear-query"
  fi
  HDR="$LEGEND
 ⏎ pick (copies path) · ⇥ show/hide transcript · ^F search inside transcripts · ^A switch agent
 ^E export .md · ^Y copy path · ^R refresh (back to fast filter) · esc quit"
  sel="$(run_py index "$AGENT" "$QUERY" "$SUB" "$CONTENT" "$DIR" | fzf \
    --ansi --delimiter='\t' --with-nth=2.. --no-hscroll --tiebreak=index \
    --exact --info=inline \
    --prompt="  $AGENT ${DIR:+(dir) }${QUERY:+[$QUERY] }› type to filter: " \
    --header="$HDR" \
    --preview="$SELQ __details {1} {q} '$STATE'" \
    --preview-window='down:60%:wrap' \
    --bind='tab:toggle-preview' \
    --bind="ctrl-f:reload($SELQ __reload '$STATE' $SUB {q} content '$DIR')$PROMPT_DEEP" \
    --bind="ctrl-a:reload($SELQ __reload '$STATE' $SUB '' next '$DIR')$PROMPT_BACK+clear-query" \
    --bind="ctrl-r:reload($SELQ __reload '$STATE' $SUB '' '' '$DIR')$PROMPT_BACK" \
    --bind="ctrl-y:execute-silent($SELQ __copy {1})" \
    --bind="ctrl-e:execute-silent($SELQ __export {1})" \
  )"
  rc=$?
  if [ $rc -eq 0 ] && [ -n "$sel" ]; then
    ref="${sel%%$'\t'*}"
    p="$(ref_path "$ref")"
    if [ -t 1 ]; then
      if copy_ref_path "$ref"; then
        printf '\033[32m✔ transcript path (copied to clipboard):\033[0m\n'
      else
        printf '\033[32m✔ transcript path:\033[0m\n'
      fi
      printf '  %s\n' "$p"
      case "$ref" in
        ca\|*|cl\|*)
          printf '\033[2m  (this chat lives inside that Cursor sqlite db — id %s;\n   use the export below for a plain file)\033[0m\n' \
            "$(printf '%s' "$ref" | cut -d'|' -f3)" ;;
      esac
      printf '\033[2mview again:\033[0m transcripts --details '\''%s'\''\n' "$ref"
      printf '\033[2mexport .md:\033[0m transcripts --export  '\''%s'\''\n' "$ref"
    else
      printf '%s\n' "$p"
    fi
    exit 0
  elif [ $rc -eq 2 ]; then
    echo "transcripts: fzf failed, dropping to basic picker" >&2
  else
    exit 130   # user cancelled / no match
  fi
fi

# ---------------------------------------------------------------- fallback TUI (no fzf)
echo "tip: 'brew install fzf' unlocks the nicer TUI (live fuzzy filter + preview pane)." >&2
OFF=0; PAGE=25
while :; do
  LIST="$(run_py index "$(state_agent "$STATE")" "$QUERY" "$SUB" "$CONTENT" "$DIR")"
  TOTAL=$(printf '%s' "$LIST" | grep -c . || true)
  echo
  printf '\033[1m── transcripts · agent: %s%s%s%s · %s found ──\033[0m\n' \
    "$(state_agent "$STATE")" "$([ -n "$QUERY" ] && printf ' · filter: "%s"' "$QUERY")" \
    "$([ -n "$DIR" ] && printf ' · dir: %s' "$DIR")" \
    "$([ "$CONTENT" = 1 ] && printf ' · content')" "$TOTAL"
  printf '  #  %s\n' "$(run_py legend)"
  if [ "$TOTAL" -eq 0 ]; then
    echo "  (nothing matches — try 'a' to switch agent or '/' to change the filter)"
  else
    printf '%s\n' "$LIST" | sed -n "$((OFF + 1)),$((OFF + PAGE))p" | awk -F'\t' -v o="$OFF" '{printf "%3d  %s\n", NR + o, $2}'
    printf '\033[2m  showing %s-%s of %s\033[0m\n' \
      "$((OFF + 1))" "$(( (OFF + PAGE) < TOTAL ? OFF + PAGE : TOTAL ))" "$TOTAL"
  fi
  echo
  echo "  type a #      open that transcript (latest messages first)"
  echo "  /words        filter list (all words must match) · / alone clears"
  echo "  a=switch agent  n=next page  p=prev page  s=toggle subagents  c=search inside  q=quit"
  printf '› '
  read -r ans || exit 0
  case "$ans" in
    q) exit 0 ;;
    a) cycle_state "$STATE"; OFF=0 ;;
    s) SUB=$((1 - SUB)); OFF=0 ;;
    c) CONTENT=$((1 - CONTENT)); OFF=0 ;;
    n) [ $((OFF + PAGE)) -lt "$TOTAL" ] && OFF=$((OFF + PAGE)) ;;
    p) OFF=$((OFF - PAGE)); [ "$OFF" -lt 0 ] && OFF=0 ;;
    /*) QUERY="${ans#/}"; OFF=0 ;;
    ''|*[!0-9]*) ;;
    *)
      ref="$(printf '%s\n' "$LIST" | sed -n "${ans}p" | cut -f1)"
      [ -z "$ref" ] && continue
      run_py details "$ref" "$QUERY" | ${PAGER:-less -R}
      p="$(ref_path "$ref")"
      printf 'c=copy+print path   e=export .md   enter=back to list › '
      read -r act
      case "$act" in
        c) printf '%s\n' "$p"; copy_ref_path "$ref" && echo "✔ copied to clipboard" ;;
        e) echo "exported: $(run_py export "$ref")" ;;
      esac
      ;;
  esac
done
