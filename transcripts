R  = "\x1b[0m";  DIM = "\x1b[2m";  BOLD = "\x1b[1m"
CY = "\x1b[36m"; MG = "\x1b[35m"; GR = "\x1b[32m"; YL = "\x1b[33m"; BL = "\x1b[34m"

def clean(s, n=0):
    s = re.sub(r"\s+", " ", (s or "")).strip()
    if n and len(s) > n: s = s[: n - 1] + "…"
    return s

def clean_end(s, n=0):
    """Like clean() but truncates from the FRONT — the end of the text is always kept."""
    s = re.sub(r"\s+", " ", (s or "")).strip()
    if n and len(s) > n: s = "…" + s[-(n - 1):]
    return s

def tailof(s, n=300):
    """End of a message: last n chars, '' when the head already holds the whole text."""
    s = re.sub(r"\s+", " ", (s or "")).strip()
    if len(s) <= n: return ""
    return "…" + s[-(n - 1):]

def tail_disp(l, z, shown, n):
    """Tail to render at width n. z = stored tail (may be '' when the 300-char head holds the
    whole message). Even then, if the DISPLAYED head ('shown' chars wide) truncates the text,
    derive the tail from the message end — empty only when the head cell shows everything."""
    if z: return clean_end(z, n)
    full = clean(l)
    if len(full) > shown: return clean_end(full, n)
    return ""

def esc(s):
    return re.sub(r"[\t\r\n\x1f]", " ", s or "")

# ------------------------------------------------------------- query matching
# One matcher for every mode: whitespace splits the query into terms, ALL must appear
# (case-insensitive substring). ponytail: no quoting/regex — add when someone needs a phrase.
def qterms(query):
    return [t for t in (query or "").lower().split() if t]

def qmatch(terms, hay):
    h = hay.lower()
    return all(t in h for t in terms)

def row_hay(r):
    """Everything the cache knows about a row — the metadata haystack."""
    return " ".join((r["n"], r["l"], r.get("z") or "", r["j"], r["i"],
                     f'{r["a"]}·{r["s"]}', r["r"] or ""))

def body_text(r):
    """Full conversation text for a row. Only called under --content: this opens the
    transcript (jsonl read / sqlite query), so it is orders of magnitude slower than row_hay."""
    try:
        _typ, _path, _rid, msgs, title = get_messages(r["f"], 2000)
    except Exception:
        return ""
    return (title or "") + " " + " ".join(m[1] for m in msgs)

def jload(b):
    try: return json.loads(b)
    except Exception: return None

def rel(ts):
    d = time.time() - ts
    if d < 0: d = 0
    if d < 60: return f"{int(d)}s"
    if d < 3600: return f"{int(d/60)}m"
    if d < 86400: return f"{int(d/3600)}h"
    if d < 604800: return f"{int(d/86400)}d"
    if d < 31536000: return f"{int(d/604800)}w"
    return time.strftime("%y-%m", time.localtime(ts))

def fmt_ts(ts):
    try: return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts))
    except Exception: return "?"

# ------------------------------------------------------------- cache
_cache = None
_cache_dirty = False
def cache_load():
    global _cache
    if _cache is None:
        try:
            with open(CACHE_FILE) as f: _cache = json.load(f)
        except Exception: _cache = {}
    return _cache

def cache_get(k):
