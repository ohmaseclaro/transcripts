#!/usr/bin/env bash
# transcripts — unified TUI browser for Cursor & Claude chat transcripts on this machine.
#
# Sources scanned:
#   claude·code   ~/.claude/projects/**/*.jsonl        (Claude Code CLI + desktop-app Code sessions)
#   claude·cwrk   same store, sessions whose cwd is a Cowork session dir (+ direct scan of the
#                 Claude app's local-agent-mode-sessions folder for any *.jsonl)
#   cursor·app    ~/Library/Application Support/Cursor/User/**/state.vscdb (composers + legacy chat tabs)
#   cursor·cli    ~/.cursor/chats/*/*/store.db          (cursor-agent CLI)
#   cursor·sub    cursor subagent transcripts (hidden unless --subagents)
#
# Usage:  (value flags accept both forms: --flag value and --flag=value)
#   transcripts                        # agent picker, then TUI
#   transcripts --agent cursor         # only cursor (also: claude, all) · short: -a
#   transcripts --query "oauth bug"    # start pre-filtered · short: -q
#   transcripts --dir ~/code/api       # only sessions run in that dir or below · short: -d
#   transcripts --here                 # shorthand for --dir "$PWD"
#   transcripts --list                 # NON-INTERACTIVE: pretty table on a terminal,
#                                      #   raw TSV when piped · combines with every filter
#                                      #   · shows last 24h unless a filter says otherwise
#   transcripts --json                 # same rows, one JSON object per line
#   transcripts --table | --tsv        # force the pretty table / force raw TSV
#                                      #   (the table drops to a per-session card layout on
#                                      #    terminals under 88 columns; the transcript path is
#                                      #    always shown in full, wrapping if it must)
#   transcripts --list --since 10d     # look-back window: Nm / Nh / Nd / Nw · short: -s
#   transcripts --list --full-list     # no time window: list everything
#   transcripts --subagents            # include cursor subagent/background transcripts (no short)
#   transcripts --scan 800             # how many transcripts --content may open (default 300)
#   transcripts --details 'REF'        # print detail view for a ref (add --json for structured)
#   transcripts --export 'REF' -o -    # markdown to stdout ('-'), a file, or a dir · default
#                                      #   ~/Downloads
#   transcripts --doctor               # show what was found where (debugging)
#   transcripts --install              # symlink into ~/.local/bin + add to PATH
#
# Filtering:
#   Filters combine (AND) and are applied cheapest-first: time window, then --dir, then the
#   query, then --content. ANY filter turns off the implicit 24h window — an unfiltered
#   --list still shows just today.
#
#   --dir/-d PATH   sessions whose working directory is PATH or anywhere below it. Claude and
#                   Cursor store transcripts in central locations, naming each project dir
#                   after the slugged cwd (/Users/me/api → -Users-me-api), so this reads the
#                   cwd recorded in the session and falls back to decoding that name.
#                   `transcripts -d . -a claude` = every claude session for this tree.
#                   --doctor reports how many sessions have a known directory.
#
#   -q WORDS        split on whitespace, EVERY word must match (case-insensitive substring).
#                   Searches cached metadata only: title, project, session id, and the first
#                   and last 300 chars of the newest message. Instant, but blind to the middle
#                   of a conversation.
#   --content/-c    ALSO read each non-matching transcript and search its messages. Slow. Stops
#                   after --scan transcripts (default 300, newest first) and says so on stderr.
#                   Narrowing with -d/-a/-s first beats raising --scan.
#
#     transcripts -q "oauth bug"                 # metadata only (fast)
#     transcripts -d . -q oauth -c               # this tree, searching inside the transcripts
#     transcripts -a claude -s 2w -c -q rotation # last two weeks of claude, deep search
#
#   Typing in the TUI uses the same matcher (fzf --exact over the same text), so the list, the
#   table and the TUI agree on what a query means.
#
#   With a query, the transcript view highlights every hit and opens on the matching messages
#   rather than the newest one — including matches deep inside a long message, which it windows
#   into view. Same for `--details REF -q term`.
#
# For scripts and agents:
#   --json      one object per line: id, source, agent, store, updated, updated_ts, updated_iso,
#               title, project, dir, subagent, last_role, last_message_head, last_message_tail,
#               path, ref
#   --tsv       id, source, updated, title, head, tail, dir, path
#   --details 'REF' --json    the conversation itself: chronological messages with role, text,
#               ts and a "matched" flag per message (with -q), plus message_count/truncated
#   --export 'REF' -o -       full transcript as markdown on stdout
#   Colour is emitted only to a terminal. NO_COLOR disables it, FORCE_COLOR forces it on.
#
# Keys (fzf mode): type=filter · enter=pick (copies path) · tab=show/hide transcript pane
#                  ctrl-f=search inside transcripts (--content on what you typed)
#                  ctrl-a=switch agent · ctrl-e=export markdown · ctrl-y=copy path · ctrl-r=refresh
set -u

VERSION="1.12.0"
SELF="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"

command -v python3 >/dev/null 2>&1 || { echo "transcripts: python3 required (macOS: xcode-select --install)"; exit 1; }

# ---------------------------------------------------------------- clipboard
_clip() {
  if command -v pbcopy >/dev/null 2>&1; then pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then xsel -ib
  else cat >/dev/null; return 1; fi
}

# ---------------------------------------------------------------- python core
run_py() { # run_py CMD ARG1..ARG6
  TR_CMD="${1:-}" TR_ARG1="${2:-}" TR_ARG2="${3:-}" TR_ARG3="${4:-}" TR_ARG4="${5:-}" \
  TR_ARG5="${6:-}" TR_ARG6="${7:-}" python3 - <<'PYCODE'
import os, sys, re, json, glob, time, sqlite3, tempfile, shutil, signal, unicodedata, atexit

try: signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except Exception: pass

CMD  = os.environ.get("TR_CMD", "")
ARG1 = os.environ.get("TR_ARG1", "")
ARG2 = os.environ.get("TR_ARG2", "")
ARG3 = os.environ.get("TR_ARG3", "")
ARG4 = os.environ.get("TR_ARG4", "")
ARG5 = os.environ.get("TR_ARG5", "")
ARG6 = os.environ.get("TR_ARG6", "")

def since_seconds(spec):
    """'10d'/'5h'/'30m' -> seconds; ''/'all' -> None; invalid -> exit 1."""
    s = (spec or "").strip().lower()
    if s in ("", "all", "full"): return None
    m = re.fullmatch(r"(\d+)\s*([dhmw])", s)
    if not m:
        sys.stderr.write(f"transcripts: invalid --since '{spec}' — use Nm, Nh, Nd or Nw "
                         f"(e.g. 30m, 5h, 10d, 2w), or 'all'\n")
        sys.exit(1)
    return int(m.group(1)) * {"d": 86400, "h": 3600, "m": 60, "w": 604800}[m.group(2)]

HOME = os.environ.get("TRANSCRIPTS_HOME") or os.path.expanduser("~")
CACHE_DIR = os.path.join(HOME, ".cache", "transcripts-tui")
CACHE_FILE = os.path.join(CACHE_DIR, "index-v6.json")
for _old in ("index-v1.json", "index-v2.json", "index-v3.json", "index-v4.json", "index-v5.json"):
    try: os.remove(os.path.join(CACHE_DIR, _old))
    except OSError: pass

try: KV_CAP = max(100, int(os.environ.get("TRANSCRIPTS_KV_CAP") or 4000))
except ValueError: KV_CAP = 4000

try: SCAN_CAP = max(1, int(os.environ.get("TRANSCRIPTS_SCAN") or 300))
except ValueError:
    sys.stderr.write(f"transcripts: --scan must be a number, got "
                     f"{os.environ.get('TRANSCRIPTS_SCAN')!r}\n")
    sys.exit(1)

# Colour goes to terminals, not to pipes. `index`/`legend` are always consumed by fzf --ansi.
# NO_COLOR (https://no-color.org) wins; FORCE_COLOR/CLICOLOR_FORCE force it back on.
def _use_color():
    if os.environ.get("NO_COLOR"): return False
    if os.environ.get("FORCE_COLOR") or os.environ.get("CLICOLOR_FORCE"): return True
    if CMD in ("index", "legend"): return True
    try: return sys.stdout.isatty()
    except Exception: return False

COLOR = _use_color()
def _c(seq): return seq if COLOR else ""

R  = _c("\x1b[0m");  DIM = _c("\x1b[2m");  BOLD = _c("\x1b[1m")
CY = _c("\x1b[36m"); MG = _c("\x1b[35m"); GR = _c("\x1b[32m")
YL = _c("\x1b[33m"); BL = _c("\x1b[34m")

# ------------------------------------------------------------- display width
# Emoji and CJK occupy two terminal columns but one Python character. Padding by len()
# misaligns every column to the right of a title containing one — and AI chat titles are
# full of emoji.
def dwidth(s):
    w = 0
    for ch in s:
        if unicodedata.combining(ch): continue
        o = ord(ch)
        if unicodedata.east_asian_width(ch) in ("W", "F") or 0x1F300 <= o <= 0x1FAFF \
           or 0x2600 <= o <= 0x27BF:
            w += 2
        elif o >= 32 or ch == "\t":
            w += 1
    return w

def clip_w(s, n):
    """Truncate to n display columns, ellipsis included."""
    if n <= 0: return ""
    if dwidth(s) <= n: return s
    out, w = [], 0
    for ch in s:
        cw = dwidth(ch)
        if w + cw > n - 1: break
        out.append(ch); w += cw
    return "".join(out) + "…"

def pad_w(s, n):
    """Left-align s in n display columns (truncating if needed)."""
    s = clip_w(s, n)
    return s + " " * max(0, n - dwidth(s))

def rpad_w(s, n):
    s = clip_w(s, n)
    return " " * max(0, n - dwidth(s)) + s

def clean(s, n=0):
    s = re.sub(r"\s+", " ", (s or "")).strip()
    if n and len(s) > n: s = s[: n - 1] + "…"
    return s

def clean_end(s, n=0):
    """Like clean() but truncates from the FRONT — the end of the text is always kept."""
    s = re.sub(r"\s+", " ", (s or "")).strip()
    if n and len(s) > n: s = "…" + s[-(n - 1):]
    return s

def tailof(s, n=300):
    """End of a message: last n chars, '' when the head already holds the whole text."""
    s = re.sub(r"\s+", " ", (s or "")).strip()
    if len(s) <= n: return ""
    return "…" + s[-(n - 1):]

def tail_disp(l, z, shown, n):
    """Tail to render at width n. z = stored tail (may be '' when the 300-char head holds the
    whole message). Even then, if the DISPLAYED head ('shown' chars wide) truncates the text,
    derive the tail from the message end — empty only when the head cell shows everything."""
    if z: return clean_end(z, n)
    full = clean(l)
    if len(full) > shown: return clean_end(full, n)
    return ""

def esc(s):
    return re.sub(r"[\t\r\n\x1f]", " ", s or "")

# ------------------------------------------------------------- query matching
# One matcher for every mode: whitespace splits the query into terms, ALL must appear
# (case-insensitive substring). ponytail: no quoting/regex — add when someone needs a phrase.
def qterms(query):
    return [t for t in (query or "").lower().split() if t]

def qmatch(terms, hay):
    h = hay.lower()
    return all(t in h for t in terms)

def row_hay(r):
    """Everything the cache knows about a row — the metadata haystack."""
    return " ".join((r["n"], r["l"], r.get("z") or "", r["j"], r["i"],
                     f'{r["a"]}·{r["s"]}', r["r"] or ""))

HL = _c("\x1b[30;43m")  # black on yellow — legible on light and dark terminals alike

def hl_re(terms):
    return re.compile("|".join(re.escape(t) for t in terms), re.I) if terms else None

def hl(t, rx, restore=""):
    """restore = the style in effect around t; the reset that ends a highlight would
    otherwise strip bold/colour from everything after the first match."""
    if not rx: return t
    return rx.sub(lambda m: f"{HL}{m.group(0)}{R}{restore}", t)

def snip(t, terms, n=700):
    """Window of t around its FIRST matching term. A match 4k chars into a message is
    invisible if the view always starts at the top of the message."""
    low = t.lower()
    hits = [i for i in (low.find(x) for x in terms) if i >= 0]
    at = min(hits) if hits else -1
    if at < 0 or at < n - 80:                       # already visible from the top
        return t[:n] + (" …" if len(t) > n else "")
    s = max(0, at - 120)
    return "… " + t[s:s + n] + (" …" if s + n < len(t) else "")

def body_text(r):
    """Full conversation text for a row. Only called under --content: this opens the
    transcript (jsonl read / sqlite query), so it is orders of magnitude slower than row_hay.
    Reads the WHOLE session — a search that quietly skipped the first half of a long
    conversation would be worse than no search at all."""
    try:
        typ = r["f"].split("|", 1)[0]
        if typ == "cc":
            return " ".join(m[1] for m in cc_messages(r["p"], 10 ** 9, whole=True))
        _typ, _path, _rid, msgs, title = get_messages(r["f"], 10 ** 9)
        return (title or "") + " " + " ".join(m[1] for m in msgs)
    except Exception:
        return ""

def jload(b):
    try: return json.loads(b)
    except Exception: return None

def rel(ts):
    d = time.time() - ts
    if d < 0: d = 0
    if d < 60: return f"{int(d)}s"
    if d < 3600: return f"{int(d/60)}m"
    if d < 86400: return f"{int(d/3600)}h"
    if d < 604800: return f"{int(d/86400)}d"
    if d < 31536000: return f"{int(d/604800)}w"
    return time.strftime("%y-%m", time.localtime(ts))

def fmt_ts(ts):
    try: return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts))
    except Exception: return "?"

def iso_ts(ts):
    """ISO 8601 with offset — unambiguous for anything consuming --json."""
    try:
        from datetime import datetime
        return datetime.fromtimestamp(ts).astimezone().isoformat(timespec="seconds")
    except Exception: return ""

# ------------------------------------------------------------- cache
_cache = None
_cache_dirty = False
def cache_load():
    global _cache
    if _cache is None:
        try:
            with open(CACHE_FILE) as f: _cache = json.load(f)
        except Exception: _cache = {}
    return _cache

def cache_get(k):
    return cache_load().get(k)

def cache_put(k, v):
    global _cache_dirty
    cache_load()[k] = v
    _cache_dirty = True

def cache_save():
    if not _cache_dirty: return
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w") as f: json.dump(_cache, f)
        os.replace(tmp, CACHE_FILE)
    except Exception: pass

def mkrow(agent, src, sid, name, role, last, ts, path, ref, proj, cwd=""):
    # "d" is the directory the session ran in (Claude's cwd / Cursor's workspace folder).
    # It is what --dir filters on; "j" is only its display label.
    return {"a": agent, "s": src, "i": sid, "n": clean(name, 200), "r": role,
            "l": clean(last, 300), "z": tailof(last, 300),
            "t": float(ts or 0), "p": path, "f": ref, "j": clean(proj, 60),
            "d": norm_dir(cwd)}

# ------------------------------------------------------------- directory scoping
def norm_dir(p):
    """Absolute, symlink-resolved, no trailing slash. '' when unknown."""
    p = (p or "").strip()
    if not p: return ""
    p = re.sub(r"^file://", "", p)
    p = os.path.expanduser(p)
    try: p = os.path.realpath(os.path.abspath(p))
    except Exception: p = os.path.abspath(p)
    return p.rstrip("/") or "/"

def slugify_dir(p):
    """Claude names its project dirs after the cwd with every '/' and '.' turned into '-'
    (Cursor does the same, minus the leading dash). The encoding is lossy — a literal '-' in a
    directory name is indistinguishable from a separator — so this is only ever a fallback."""
    return re.sub(r"[/.]", "-", p)

_UNSLUG = {}
def unslug_dir(slug):
    """Best-effort inverse of the slug encoding, disambiguated against the filesystem: walk
    segment by segment taking the longest join that names a real directory, so 'omni-360' and
    'ohmaseclaro-lahzo' both resolve correctly. '' when it can't be resolved."""
    if slug in _UNSLUG: return _UNSLUG[slug]
    parts = [p for p in slug.split("-") if p]
    cur, i = "/", 0
    while i < len(parts):
        for j in range(len(parts), i, -1):                  # longest candidate first
            seg = "-".join(parts[i:j])
            for cand in (os.path.join(cur, seg), os.path.join(cur, "." + seg)):
                if os.path.isdir(cand):
                    cur, i = cand, j
                    break
            else:
                continue
            break
        else:
            cur = ""; break
    _UNSLUG[slug] = cur if cur != "/" else ""
    return _UNSLUG[slug]

def under_dir(row, target):
    """True when the session ran in target or anywhere below it.

    Preferred signal is the recorded working directory. Falling back to the slugged directory
    name in the store path catches sessions whose project directory has since been deleted or
    renamed — unslug_dir() can't resolve those because the path no longer exists on disk."""
    if not target: return True
    d = row.get("d") or ""
    if d:
        return d == target or d.startswith(target + "/")
    s = slugify_dir(target).strip("-")
    if not s: return False
    for seg in (row.get("p") or "").split("/"):
        seg = seg.strip("-")
        if seg == s or seg.startswith(s + "-"): return True
    return False

# ------------------------------------------------------------- sqlite helper
# Opening a Cursor db can mean copying it (when Cursor holds the lock), and the global
# state.vscdb is measured in gigabytes. --content walks hundreds of rows that all live in the
# same handful of databases, so connections are pooled for the life of the process. close() on
# a handed-out handle is a no-op; the pool owns teardown. The pool is small because macOS
# defaults to a 256-descriptor limit and there can be thousands of store.db files.
_DBPOOL = {}          # path -> (connection, tempdir or None)
_DBPOOL_MAX = 8

class _Pooled:
    """Connection handle whose close() is a no-op — the pool closes the real one."""
    __slots__ = ("_con",)
    def __init__(self, con): self._con = con
    def execute(self, *a, **k): return self._con.execute(*a, **k)
    def close(self): pass

def _dbpool_drop(path):
    con, td = _DBPOOL.pop(path, (None, None))
    if con is not None:
        try: con.close()
        except Exception: pass
    if td: shutil.rmtree(td, ignore_errors=True)

@atexit.register
def _dbpool_clear():
    for p in list(_DBPOOL): _dbpool_drop(p)

def db_ro(path):
    if path in _DBPOOL:
        return _Pooled(_DBPOOL[path][0]), None
    con = td = None
    try:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=0.8)
        con.execute("select 1 from sqlite_master limit 1").fetchone()
    except Exception:
        con = None
    if con is None:
        try:
            if os.path.getsize(path) > 2_000_000_000:
                raise Exception("db locked and too large to copy")
        except OSError: pass
        td = tempfile.mkdtemp(prefix="trx-")
        for ext in ("", "-wal", "-shm"):
            s = path + ext
            if os.path.exists(s):
                try: shutil.copy2(s, os.path.join(td, "db" + ext))
                except Exception: pass
        con = sqlite3.connect(f"file:{os.path.join(td,'db')}?mode=ro", uri=True)
    while len(_DBPOOL) >= _DBPOOL_MAX:
        _dbpool_drop(next(iter(_DBPOOL)))
    _DBPOOL[path] = (con, td)
    return _Pooled(con), None

# ------------------------------------------------------------- claude jsonl
CC_SKIP = ("<command-name>", "<command-message>", "<local-command", "Caveat: The messages below",
           "<system-reminder", "[Request interrupted")

def blk_text(content):
    if isinstance(content, str): return content
    if isinstance(content, list):
        out = []
        for p in content:
            if isinstance(p, dict) and p.get("type") == "text" and p.get("text"):
                out.append(p["text"])
        return "\n".join(out)
    return ""

def cc_line_text(d):
    if d.get("isMeta"): return None
    m = d.get("message") or {}
    t = blk_text(m.get("content")).strip()
    if not t: return None
    for p in CC_SKIP:
        if t.startswith(p): return None
    mm = re.search(r"<user_query>\s*(.*?)\s*</user_query>", t, re.S)
    if mm: t = mm.group(1).strip()
    return t or None

NOISE_PREFIX = ("This session is being continued from a previous conversation",
                "Caveat:", "[Request interrupted")

def is_noise(t):
    """True for texts that make terrible titles/last-messages (tag blobs, compaction preambles)."""
    ts = t.lstrip()
    if ts.startswith("<"): return True
    return any(ts.startswith(p) for p in NOISE_PREFIX)

def strip_tags(t):
    return clean(re.sub(r"<[^>]{1,120}>", " ", t))

def head_tail(f, n_head=250, tail_bytes=262144):
    head = []
    with open(f, "rb") as fh:
        for i, l in enumerate(fh):
            if i >= n_head: break
            head.append(l)
        fh.seek(0, 2); size = fh.tell()
        fh.seek(max(0, size - tail_bytes))
        tail = fh.read().split(b"\n")
    return head, tail

def _user_homes():
    """This user's home + any other readable account homes (multi-account machines).
    An explicit TRANSCRIPTS_HOME means "look only here" — used by tests and by anyone
    pointing the tool at a copied/mounted home."""
    if os.environ.get("TRANSCRIPTS_HOME"): return [HOME]
    homes = [HOME]
    for pat in ("/Users/*", "/home/*"):
        for h in glob.glob(pat):
            try:
                if os.path.realpath(h) != os.path.realpath(HOME) and os.path.isdir(h) \
                   and os.access(h, os.R_OK | os.X_OK):
                    homes.append(h)
            except OSError: pass
    return homes

def claude_files():
    files = []
    for h in _user_homes():
        for r in (os.path.join(h, ".claude", "projects"),
                  os.path.join(h, ".config", "claude", "projects")):
            try: files += glob.glob(os.path.join(r, "*", "*.jsonl"))
            except OSError: pass
        lam = os.path.join(h, "Library", "Application Support", "Claude", "local-agent-mode-sessions")
        if os.path.isdir(lam):
            try: files += glob.glob(os.path.join(lam, "**", "*.jsonl"), recursive=True)
            except OSError: pass
    seen, out = set(), []
    for f in files:
        rp = os.path.realpath(f)
        if rp not in seen:
            seen.add(rp); out.append(rp)
    return out

def parse_cc(f, st):
    """Returns {"r": row_or_None, "x": aux}; aux carries summary lines + uuid samples + cwd."""
    head, tail = head_tail(f, 300, 524288)
    name = cwd = None
    own = 0            # 1 = summary/title record, 2 = chat-window title (ai-title/custom-title)
    ai_t = cu_t = None # window titles seen in head (keep newest = last)
    first_c = first_n = None
    sums = {}          # leafUuid -> summary text (found in THIS file)
    head_ids = []      # sampled uuid/parentUuid, oldest first
    for b in head:
        d = jload(b)
        if not d: continue
        t = d.get("type")
        if t == "ai-title":
            v = d.get("aiTitle")
            if isinstance(v, str) and v.strip(): ai_t = v.strip()
            continue
        if t == "custom-title":
            v = d.get("customTitle")
            if isinstance(v, str) and v.strip(): cu_t = v.strip()
            continue
        if t == "summary":
            if d.get("leafUuid"): sums[d["leafUuid"]] = d.get("summary") or ""
            if not name and d.get("summary"): name, own = d["summary"], 1
            continue
        if not name:
            for k in ("title", "sessionTitle", "session_title"):
                v = d.get(k)
                if isinstance(v, str) and 2 < len(v.strip()) < 200:
                    name, own = v.strip(), 1; break
        if not cwd and d.get("cwd"): cwd = d["cwd"]
        if t in ("user", "assistant") and not d.get("isSidechain"):
            for k in ("uuid", "parentUuid"):
                if d.get(k): head_ids.append(d[k])
            if t == "user" and not first_c:
                x = cc_line_text(d)
                if x:
                    if is_noise(x): first_n = first_n or x
                    else: first_c = x
    last_c = last_n = None; role_c = role_n = ""
    tai = tcu = None   # window titles seen in tail (reversed scan → first hit is newest)
    tail_ids = []      # newest first
    for b in reversed(tail):
        d = jload(b)
        if not d: continue
        t = d.get("type")
        if t == "ai-title" and tai is None:
            v = d.get("aiTitle")
            if isinstance(v, str) and v.strip(): tai = v.strip()
            continue
        if t == "custom-title" and tcu is None:
            v = d.get("customTitle")
            if isinstance(v, str) and v.strip(): tcu = v.strip()
            continue
        if t == "summary":
            if d.get("leafUuid"): sums.setdefault(d["leafUuid"], d.get("summary") or "")
            continue
        if t not in ("user", "assistant") or d.get("isSidechain"): continue
        if not cwd and d.get("cwd"): cwd = d["cwd"]
        for k in ("uuid", "parentUuid"):
            if d.get(k): tail_ids.append(d[k])
        if last_c is None:
            x = cc_line_text(d)
            if x:
                r_ = "user" if t == "user" else "claude"
                if is_noise(x):
                    if last_n is None: last_n, role_n = x, r_
                else: last_c, role_c = x, r_
    win = (tcu or cu_t) or (tai or ai_t)   # actual chat-window name; custom > ai, newest wins
    if win: name, own = win, 2
    first = first_c or (strip_tags(first_n) if first_n else None)
    last = last_c or (strip_tags(last_n) if last_n else None)
    role = role_c or role_n
    aux = {"s": sums, "hi": head_ids[:60], "ti": tail_ids[:120], "c": cwd or "", "ow": own}
    if not (name or first or last):
        return {"r": None, "x": aux}
    slug = os.path.basename(os.path.dirname(f))
    cowork = "local-agent-mode-sessions" in (cwd or "") or "local-agent-mode-sessions" in slug \
             or "local-agent-mode-sessions" in f
    sid = os.path.splitext(os.path.basename(f))[0]
    if cowork:
        m = re.search(r"local_([0-9a-f]{8})", (cwd or "") + " " + slug + " " + f)
        proj = "cowork:" + m.group(1) if m else "cowork"
        src = "cwrk"
    else:
        proj = os.path.basename(cwd) if cwd else (slug.rsplit("-", 1)[-1] or slug)
        src = "code"
    row = mkrow("claude", src, sid, name or first or "(untitled)", role, last or "",
                st.st_mtime, f, f"cc|{f}|{sid}", proj, cwd or unslug_dir(slug))
    return {"r": row, "x": aux}

def _title_walk(d, out, depth=0):
    """Harvest sessionId->title pairs from arbitrary JSON structures."""
    if depth > 6: return
    if isinstance(d, dict):
        sid = tit = None
        for k, v in d.items():
            kl = (k or "").lower()
            if re.fullmatch(r"[0-9a-fA-F-]{32,40}", k or ""):     # {"<uuid>": "title"} / {"<uuid>": {...}}
                if isinstance(v, str) and 2 < len(v.strip()) < 200:
                    out.setdefault(k, v.strip())
                elif isinstance(v, dict):
                    for tk in ("title", "summary", "name", "displayName", "display_name"):
                        tv = v.get(tk)
                        if isinstance(tv, str) and 2 < len(tv.strip()) < 200:
                            out.setdefault(k, tv.strip()); break
            if not isinstance(v, str): continue
            if kl in ("sessionid", "session_id", "id", "uuid") and re.fullmatch(r"[0-9a-fA-F-]{8,}", v):
                sid = sid or v
            if kl in ("title", "summary", "name", "displayname", "display_name") and 2 < len(v.strip()) < 200:
                tit = tit or v.strip()
        if sid and tit: out.setdefault(sid, tit)
        for v in d.values(): _title_walk(v, out, depth + 1)
    elif isinstance(d, list):
        for v in d[:2000]: _title_walk(v, out, depth + 1)

def external_claude_titles():
    """sessionId -> title from any index json + __store.db in every readable account's config."""
    out = {}
    roots = []
    for h in _user_homes():
        roots += [os.path.join(h, ".claude"), os.path.join(h, ".config", "claude")]
    for r_ in roots:
        if not os.path.isdir(r_): continue
        pats = [os.path.join(r_, "projects", "*", "*.json"),
                os.path.join(r_, "projects", "*.json"),
                os.path.join(r_, "*.json")]
        for pat in pats:
            for jf in glob.glob(pat):
                try:
                    if os.path.getsize(jf) > 2_000_000: continue
                    with open(jf) as fh: _title_walk(json.load(fh), out)
                except Exception: pass
        db = os.path.join(r_, "__store.db")
        if not os.path.exists(db): continue
        try: con, td = db_ro(db)
        except Exception: continue
        try:
            for (tn,) in con.execute("select name from sqlite_master where type='table'"):
                try: cols = [c[1] for c in con.execute(f'pragma table_info("{tn}")')]
                except Exception: continue
                idc = next((c for c in cols if c.lower() in ("session_id", "sessionid", "conversation_id", "uuid", "id")), None)
                tc  = next((c for c in cols if c.lower() in ("summary", "title", "name", "display_name")), None)
                if not idc or not tc: continue
                try:
                    for i_, t_ in con.execute(f'select "{idc}","{tc}" from "{tn}"'):
                        if isinstance(i_, str) and isinstance(t_, str) and t_.strip():
                            out.setdefault(i_, t_.strip())
                except Exception: pass
        finally:
            con.close()
            if td: shutil.rmtree(td, ignore_errors=True)
    return out

def _sidecar_title(sdir, _cache={}):
    """Best-effort title from small json files in a Cowork session dir."""
    if sdir in _cache: return _cache[sdir]
    tit = None
    def find(d, depth=0):
        if depth > 5: return None
        if isinstance(d, dict):
            for k in ("title", "conversationTitle", "sessionTitle", "summary"):
                v = d.get(k)
                if isinstance(v, str) and 2 < len(v.strip()) < 200: return v.strip()
            for v in d.values():
                r = find(v, depth + 1)
                if r: return r
        elif isinstance(d, list):
            for v in d[:200]:
                r = find(v, depth + 1)
                if r: return r
        return None
    try:
        for jf in sorted(glob.glob(os.path.join(sdir, "*.json"))):
            if os.path.getsize(jf) > 1_000_000: continue
            try:
                with open(jf) as fh: tit = find(json.load(fh))
            except Exception: continue
            if tit: break
    except Exception: pass
    _cache[sdir] = tit
    return tit

TITLE_STATS = {"window": 0, "map": 0, "own": 0, "ext": 0, "sidecar": 0, "deep": 0, "fallback": 0}
UNTITLED_SAMPLES = []

def deep_title_scan(path, summap):
    """Bounded full-file scan: prefer mid-file ai-title/custom-title lines, else the newest
    known summary leafUuid, collecting extra summary records on the way.
    Returns (title_or_None, bytes_scanned)."""
    try: size = os.path.getsize(path)
    except OSError: return None, 0
    keys = [k for k in summap if k and re.fullmatch(r"[0-9a-fA-F-]{32,40}", k)]
    rx = re.compile(b"|".join(re.escape(k.encode()) for k in keys)) if keys else None
    CAP = 33_554_432
    regions = [(0, size)] if size <= 2 * CAP else [(0, CAP), (size - CAP, CAP)]
    found = None; scanned = 0
    tkind = ""; ttext = None            # window title: custom beats ai, later beats earlier
    try:
        with open(path, "rb") as fh:
            for off, ln in regions:
                fh.seek(off); data = fh.read(ln); scanned += len(data)
                if b'"ai-title"' in data or b'"custom-title"' in data:
                    for line in data.split(b"\n"):
                        if b'"ai-title"' not in line and b'"custom-title"' not in line: continue
                        d = jload(line)
                        if not d: continue
                        if d.get("type") == "custom-title" and d.get("customTitle"):
                            tkind, ttext = "c", d["customTitle"]
                        elif d.get("type") == "ai-title" and d.get("aiTitle") and tkind != "c":
                            tkind, ttext = "a", d["aiTitle"]
                if b'"summary"' in data:
                    for line in data.split(b"\n"):
                        if b'"type":"summary"' in line or b'"type": "summary"' in line:
                            d = jload(line)
                            if d and d.get("leafUuid") and d.get("summary"):
                                summap.setdefault(d["leafUuid"], d["summary"])
                if rx:
                    for m in rx.finditer(data): found = m.group(0)
    except OSError:
        return (ttext, scanned) if ttext else (None, scanned)
    if ttext: return ttext, scanned
    return (summap.get(found.decode()) if found else None), scanned

def scan_claude(rows, errors):
    entries = []
    for f in claude_files():
        try: st = os.stat(f)
        except OSError: continue
        if st.st_size == 0: continue
        ck = f"{f}|{st.st_mtime_ns}|{st.st_size}"
        c = cache_get(ck)
        if c is None:
            try: c = parse_cc(f, st)
            except Exception as e:
                errors.append(f"{f}: {e}"); continue
            cache_put(ck, c)
        if not (isinstance(c, dict) and "x" in c):
            c = {"r": c or None, "x": {"s": {}, "hi": [], "ti": [], "c": ""}}
        entries.append((ck, c))
    summap = {}
    for _ck, e in entries:
        for k, v in (e["x"].get("s") or {}).items():
            if v: summap[k] = v
    ext = external_claude_titles() if entries else {}
    untitled = []
    for ck, e in entries:
        r = e["r"]
        if not r: continue
        x = e["x"]
        if x.get("ow") == 2:            # real chat-window name found in-file — authoritative
            TITLE_STATS["window"] += 1
            rows.append(r); continue
        title = how = None
        for u in (x.get("ti") or []):               # newest first
            if u in summap: title, how = summap[u], "map"; break
        if not title:
            for u in reversed(x.get("hi") or []):
                if u in summap: title, how = summap[u], "map"; break
        if not title and ext.get(r["i"]): title, how = ext[r["i"]], "ext"
        if not title and r["s"] == "cwrk" and x.get("c"):
            t = _sidecar_title(os.path.dirname(x["c"].rstrip("/")))
            if t: title, how = t, "sidecar"
        if title:
            if title != r["n"]:
                r["n"] = clean(title, 200); cache_put(ck, e)
            TITLE_STATS[how] += 1
        elif x.get("ow"):
            TITLE_STATS["own"] += 1
        else:
            untitled.append((ck, e))
        rows.append(r)
    # deep pass: bounded whole-file scan for sessions whose summary leaf sits mid-file
    budget = 1_500_000_000
    for ck, e in sorted(untitled, key=lambda t_: -t_[1]["r"]["t"]):
        r, x = e["r"], e["x"]
        if x.get("deep") or budget <= 0:
            TITLE_STATS["fallback"] += 1
            if x.get("deep") and len(UNTITLED_SAMPLES) < 5:
                UNTITLED_SAMPLES.append(r["p"])
            continue
        t, scanned = deep_title_scan(r["p"], summap)
        budget -= max(scanned, 1)
        x["deep"] = 1
        if t:
            r["n"] = clean(t, 200)
            TITLE_STATS["deep"] += 1
        else:
            TITLE_STATS["fallback"] += 1
            if len(UNTITLED_SAMPLES) < 5: UNTITLED_SAMPLES.append(r["p"])
        cache_put(ck, e)

